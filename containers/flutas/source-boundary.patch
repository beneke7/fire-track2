diff --git a/src/restas_source.inc b/src/restas_source.inc
new file mode 100644
index 0000000..a871004
--- /dev/null
+++ b/src/restas_source.inc
@@ -0,0 +1,676 @@
+  subroutine restas_source_read()
+    implicit none
+    integer :: iunit,ierr,islot
+    logical :: exists
+    inquire(file='source-boundary.in',exist=exists)
+    if(.not.exists) return
+    open(newunit=iunit,file='source-boundary.in',status='old',action='read',iostat=ierr)
+    if(ierr.ne.0) error stop 'Cannot open source-boundary.in'
+    read(iunit,*,iostat=ierr) restas_slot_count
+    if(ierr.ne.0) error stop 'Invalid source slot count'
+    if(restas_slot_count.lt.0.or.restas_slot_count.gt.4.or. &
+       (restas_slot_count.gt.0.and.restas_slot_count.ne.1.and.restas_slot_count.ne.4)) &
+      error stop 'Source diagnostic supports zero, one, or four slots'
+    read(iunit,*,iostat=ierr) restas_grid
+    if(ierr.ne.0) error stop 'Invalid source grid record'
+    read(iunit,*,iostat=ierr) restas_step_on,restas_step_off
+    if(ierr.ne.0) error stop 'Invalid source step interval'
+    read(iunit,*,iostat=ierr) restas_dt
+    if(ierr.ne.0) error stop 'Invalid source time step'
+    read(iunit,*,iostat=ierr) restas_source_velocity
+    if(ierr.ne.0) error stop 'Invalid source velocity record'
+    read(iunit,*,iostat=ierr) restas_background_velocity
+    if(ierr.ne.0) error stop 'Invalid background velocity record'
+    read(iunit,*,iostat=ierr) restas_gravity
+    if(ierr.ne.0) error stop 'Invalid gravity record'
+    read(iunit,*,iostat=ierr) restas_short_x,restas_long_y,restas_gap_x,restas_gap_y
+    if(ierr.ne.0) error stop 'Invalid source geometry record'
+    do islot=1,restas_slot_count
+      read(iunit,*,iostat=ierr) restas_slot_i0(islot),restas_slot_i1(islot), &
+        restas_slot_j0(islot),restas_slot_j1(islot)
+      if(ierr.ne.0) error stop 'Invalid source slot mask'
+    enddo
+    close(iunit)
+    if(restas_slot_count.eq.0) then
+      if(restas_step_on.ne.0.or.restas_step_off.ne.0) &
+        error stop 'Dry diagnostic requires the disabled interval [0,0)'
+    else
+      if(restas_step_on.lt.0.or.restas_step_off.le.restas_step_on) &
+        error stop 'Invalid half-open source step interval'
+    endif
+    if(restas_source_velocity(3).ge.0._rp) &
+      error stop 'The upper source must point into negative z'
+    if(abs(restas_background_velocity(3)).gt.restas_input_tol) &
+      error stop 'This diagnostic requires zero initial vertical flow'
+    if(any(restas_slot_i0(1:restas_slot_count).lt.1).or. &
+       any(restas_slot_j0(1:restas_slot_count).lt.1)) &
+      error stop 'Source indices are one-based'
+    if(any(restas_slot_i1(1:restas_slot_count).lt.restas_slot_i0(1:restas_slot_count)).or. &
+       any(restas_slot_j1(1:restas_slot_count).lt.restas_slot_j0(1:restas_slot_count))) &
+      error stop 'Source mask extents are inverted'
+    restas_source_loaded=.true.
+  end subroutine restas_source_read
+  !
+  logical function restas_source_enabled()
+    implicit none
+    restas_source_enabled=restas_source_loaded
+  end function restas_source_enabled
+  !
+  logical function restas_source_active_at(step_index)
+    implicit none
+    integer, intent(in) :: step_index
+    restas_source_active_at=.false.
+    if(.not.restas_source_loaded) return
+    restas_source_active_at=(step_index.ge.restas_step_on.and.step_index.lt.restas_step_off)
+  end function restas_source_active_at
+  !
+  subroutine restas_source_get_background(velocity)
+    implicit none
+    real(rp), intent(out) :: velocity(3)
+    velocity=restas_background_velocity
+  end subroutine restas_source_get_background
+  !
+  subroutine restas_source_get_velocity(velocity)
+    implicit none
+    real(rp), intent(out) :: velocity(3)
+    velocity=restas_source_velocity
+  end subroutine restas_source_get_velocity
+  !
+  logical function restas_source_cell(i,j)
+    implicit none
+    integer, intent(in) :: i,j
+    integer :: islot
+    restas_source_cell=.false.
+    do islot=1,restas_slot_count
+      if(i.ge.restas_slot_i0(islot).and.i.le.restas_slot_i1(islot).and. &
+         j.ge.restas_slot_j0(islot).and.j.le.restas_slot_j1(islot)) then
+        restas_source_cell=.true.
+        return
+      endif
+    enddo
+  end function restas_source_cell
+  !
+  subroutine restas_source_validate(ng,dl,dt_input,constant_dt,cbcvel,cbcpre,cbcvof, &
+                                   bcvel,bcpre,bcvof,is_outflow,restart,late_init, &
+                                   is_forced,gacc,bvel,dpdl,bulk_ftype)
+    implicit none
+    integer, intent(in) :: ng(3)
+    real(rp), intent(in) :: dl(3),dt_input
+    logical, intent(in) :: constant_dt,restart,late_init
+    character(len=1), intent(in) :: cbcvel(0:1,3,3),cbcpre(0:1,3),cbcvof(0:1,3)
+    real(rp), intent(in) :: bcvel(0:1,3,3),bcpre(0:1,3),bcvof(0:1,3)
+    logical, intent(in) :: is_outflow(0:1,3),is_forced(3)
+    real(rp), intent(in) :: gacc(3),bvel(3),dpdl(3)
+    character(len=*), intent(in) :: bulk_ftype
+    integer :: islot,jslot,nxslot,nyslot,xlo(2),ylo(2),ix,iy
+    integer :: combinations(2,2),expected_i0(4),expected_i1(4)
+    integer :: expected_j0(4),expected_j1(4)
+    real(rp) :: q0,q1
+    if(.not.restas_source_loaded) return
+    if(any(ng.ne.restas_grid)) error stop 'Source grid does not match the case grid'
+    if(any(ng.ne.(/160,84,40/))) error stop 'Source fixture grid is frozen at 160x84x40'
+    if(product(ng).gt.1000000) error stop 'Source diagnostic is capped below one million cells'
+    if(any(abs(dl-0.025_rp).gt.restas_input_tol)) &
+      error stop 'Source fixture requires uniform 0.025 m spacing'
+    if(any(abs(real(ng,rp)*dl-(/4._rp,2.1_rp,1._rp/)).gt.restas_input_tol)) &
+      error stop 'Source fixture extents are frozen at 4.0x2.1x1.0 m'
+    if(.not.constant_dt.or.dt_input.le.0._rp) &
+      error stop 'Source diagnostic requires fixed positive dt'
+    if(abs(dt_input-restas_dt).gt.restas_input_tol.or. &
+       abs(dt_input-1.e-4_rp).gt.restas_input_tol) &
+      error stop 'Source fixture time step is frozen at 1.0e-4 s'
+    if(restas_slot_count.eq.0) then
+      if(restas_step_on.ne.0.or.restas_step_off.ne.0) &
+        error stop 'Dry fixture uses the disabled interval [0,0)'
+    else
+      if(restas_step_on.ne.2.or.restas_step_off.ne.12) &
+        error stop 'Source interval is frozen to zero-based [2,12)'
+    endif
+    if(abs(restas_source_velocity(3)+4.8_rp).gt.restas_input_tol) &
+      error stop 'Source normal speed is frozen at W=-4.8 m/s'
+    if(abs(restas_short_x-0.15_rp).gt.restas_input_tol.or. &
+       abs(restas_long_y-1._rp).gt.restas_input_tol.or. &
+       abs(restas_gap_x-0.05_rp).gt.restas_input_tol.or. &
+       abs(restas_gap_y-0.05_rp).gt.restas_input_tol) &
+      error stop 'Provisional slot dimensions and gaps are frozen'
+    if(restart.or.late_init) &
+      error stop 'Source diagnostic does not support restart or late initialization'
+    if(any(abs(gacc-restas_gravity).gt.restas_input_tol)) &
+      error stop 'dns.in gravity differs from source-boundary.in'
+    if(abs(restas_background_velocity(2)).gt.restas_input_tol.or. &
+       (abs(restas_background_velocity(1)).gt.restas_input_tol.and. &
+        abs(restas_background_velocity(1)+50._rp).gt.restas_input_tol)) &
+      error stop 'Background is frozen to quiescent U=0 or crossflow U=-50, with V=0'
+    if(abs(restas_source_velocity(1)-restas_background_velocity(1)).gt.restas_input_tol.or. &
+       abs(restas_source_velocity(2)-restas_background_velocity(2)).gt.restas_input_tol) &
+      error stop 'Source tangential velocity must match the fixed z-face values'
+    if(abs(restas_gravity(1)).gt.restas_input_tol.or. &
+       abs(restas_gravity(2)).gt.restas_input_tol.or. &
+       (abs(restas_background_velocity(1)).lt.restas_input_tol.and. &
+        abs(restas_gravity(3)).gt.restas_input_tol).or. &
+       (restas_background_velocity(1).lt.-1._rp.and. &
+        abs(restas_gravity(3)+9.81_rp).gt.restas_input_tol)) &
+      error stop 'Gravity is frozen to 0 or gz=-9.81 for crossflow'
+    if(any(is_forced)) error stop 'Source diagnostic requires is_forced=false on all axes'
+    if(any(abs(bvel).gt.restas_input_tol).or.any(abs(dpdl).gt.restas_input_tol)) &
+      error stop 'Source diagnostic requires zero bvel and dpdl'
+    if(trim(bulk_ftype).ne.'cfr') error stop 'Source diagnostic freezes bulk_ftype=cfr'
+    q0=real(restas_step_on,rp)
+    q1=real(restas_step_off,rp)
+    if(restas_slot_count.gt.0.and.q1.le.q0) error stop 'Invalid source interval'
+    if(any(dl.le.0._rp)) error stop 'Source diagnostic requires positive grid spacing'
+    if(abs(real(nint(restas_short_x/dl(1)),rp)*dl(1)-restas_short_x).gt.restas_input_tol.or. &
+       abs(real(nint(restas_long_y/dl(2)),rp)*dl(2)-restas_long_y).gt.restas_input_tol) &
+      error stop 'Source dimensions do not align with the grid'
+    if(abs(real(nint(restas_gap_x/dl(1)),rp)*dl(1)-restas_gap_x).gt.restas_input_tol.or. &
+       abs(real(nint(restas_gap_y/dl(2)),rp)*dl(2)-restas_gap_y).gt.restas_input_tol) &
+      error stop 'Source gaps do not align with the grid'
+    nxslot=nint(restas_short_x/dl(1))
+    nyslot=nint(restas_long_y/dl(2))
+    if(any(restas_slot_i1(1:restas_slot_count).gt.ng(1)).or. &
+       any(restas_slot_j1(1:restas_slot_count).gt.ng(2))) &
+      error stop 'Source mask exceeds the domain'
+    expected_i0=(/74,82,74,82/)
+    expected_i1=(/79,87,79,87/)
+    expected_j0=(/2,2,44,44/)
+    expected_j1=(/41,41,83,83/)
+    if(any(restas_slot_i0(1:restas_slot_count).ne.expected_i0(1:restas_slot_count)).or. &
+       any(restas_slot_i1(1:restas_slot_count).ne.expected_i1(1:restas_slot_count)).or. &
+       any(restas_slot_j0(1:restas_slot_count).ne.expected_j0(1:restas_slot_count)).or. &
+       any(restas_slot_j1(1:restas_slot_count).ne.expected_j1(1:restas_slot_count))) &
+      error stop 'Source mask indices differ from the frozen provisional geometry'
+    if(any(restas_slot_i1(1:restas_slot_count)-restas_slot_i0(1:restas_slot_count)+1.ne.nxslot).or. &
+       any(restas_slot_j1(1:restas_slot_count)-restas_slot_j0(1:restas_slot_count)+1.ne.nyslot)) &
+      error stop 'Source mask area differs from declared dimensions'
+    do islot=1,restas_slot_count
+      do jslot=islot+1,restas_slot_count
+        if(max(restas_slot_i0(islot),restas_slot_i0(jslot)).le. &
+           min(restas_slot_i1(islot),restas_slot_i1(jslot)).and. &
+           max(restas_slot_j0(islot),restas_slot_j0(jslot)).le. &
+           min(restas_slot_j1(islot),restas_slot_j1(jslot))) &
+          error stop 'Source masks overlap'
+      enddo
+    enddo
+    if(restas_slot_count.eq.4) then
+      xlo=(/minval(restas_slot_i0(1:4)),maxval(restas_slot_i0(1:4))/)
+      ylo=(/minval(restas_slot_j0(1:4)),maxval(restas_slot_j0(1:4))/)
+      if(xlo(1).eq.xlo(2).or.ylo(1).eq.ylo(2)) &
+        error stop 'Four slots must occupy two positions on each axis'
+      combinations=0
+      do islot=1,4
+        ix=1
+        iy=1
+        if(restas_slot_i0(islot).eq.xlo(2)) ix=2
+        if(restas_slot_j0(islot).eq.ylo(2)) iy=2
+        combinations(ix,iy)=combinations(ix,iy)+1
+      enddo
+      if(any(combinations.ne.1)) error stop 'Four slots must form a complete 2x2 array'
+      if(abs(real(xlo(2)-minval(restas_slot_i1(1:4), &
+             mask=restas_slot_i0(1:4).eq.xlo(1))-1,rp)*dl(1)-restas_gap_x).gt.restas_input_tol) &
+        error stop 'x-axis gap does not match declaration'
+      if(abs(real(ylo(2)-minval(restas_slot_j1(1:4), &
+             mask=restas_slot_j0(1:4).eq.ylo(1))-1,rp)*dl(2)-restas_gap_y).gt.restas_input_tol) &
+        error stop 'y-axis gap does not match declaration'
+    endif
+    ! The accepted paired faces are periodic x/y and fixed-normal DD/NN z.
+    if(any(cbcpre(:,1).ne.'P').or.any(cbcpre(:,2).ne.'P').or.any(cbcpre(:,3).ne.'N')) &
+      error stop 'Source case requires pressure PP,PP,NN'
+    if(any(abs(bcpre).gt.restas_input_tol)) error stop 'Pressure values are frozen to zero'
+    if(any(cbcvof(:,1).ne.'P').or.any(cbcvof(:,2).ne.'P').or.any(cbcvof(:,3).ne.'N')) &
+      error stop 'Source case requires VOF PP,PP,NN'
+    if(any(abs(bcvof).gt.restas_input_tol)) error stop 'VOF boundary values are frozen to zero gradient'
+    if(any(cbcvel(:,1,:).ne.'P').or.any(cbcvel(:,2,:).ne.'P').or.any(cbcvel(:,3,:).ne.'D')) &
+      error stop 'Source case requires velocity PP,PP,DD on all components'
+    if(any(is_outflow)) error stop 'Paired source/return faces require is_outflow=false'
+    if(any(abs(bcvel(:,3,1)-restas_background_velocity(1)).gt.restas_input_tol).or. &
+       any(abs(bcvel(:,3,2)-restas_background_velocity(2)).gt.restas_input_tol)) &
+      error stop 'Tangential z-face values must match the background velocity'
+    if(any(abs(bcvel(:,3,3)).gt.restas_input_tol)) &
+      error stop 'Normal z-face base velocity values must be zero before source overrides'
+    if(abs(restas_source_velocity(1)-restas_background_velocity(1)).gt.restas_input_tol.or. &
+       abs(restas_source_velocity(2)-restas_background_velocity(2)).gt.restas_input_tol) &
+      error stop 'Source tangential velocity must match the fixed z-face values'
+    q0=real(restas_step_on,rp)*dt_input
+    q1=real(restas_step_off,rp)*dt_input
+    if(q1.le.q0) error stop 'Invalid source schedule duration'
+  end subroutine restas_source_validate
+  !
+  subroutine restas_source_set_initial_flow(n,nh_u,u,v,w)
+    implicit none
+    integer, intent(in) :: n(3),nh_u
+    real(rp), intent(inout) :: u(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(inout) :: v(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(inout) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    integer :: i,j,k
+    if(.not.restas_source_loaded) return
+    do k=1,n(3)
+      do j=1,n(2)
+        do i=1,n(1)
+          u(i,j,k)=restas_background_velocity(1)
+          v(i,j,k)=restas_background_velocity(2)
+          w(i,j,k)=restas_background_velocity(3)
+        enddo
+      enddo
+    enddo
+  end subroutine restas_source_set_initial_flow
+  !
+  subroutine restas_source_apply_velocity(n,nh_u,step_index,dl,u,v,w,qtop,qbottom)
+    implicit none
+    integer, intent(in) :: n(3),nh_u,step_index
+    real(rp), intent(in) :: dl(3)
+    real(rp), intent(inout) :: u(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(inout) :: v(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(inout) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(out) :: qtop,qbottom
+    integer :: islot,i,j
+    logical :: active
+    real(rp) :: face_area,return_velocity
+    qtop=0._rp
+    qbottom=0._rp
+    if(.not.restas_source_loaded) return
+    active=restas_source_active_at(step_index)
+    face_area=dl(1)*dl(2)
+    ! W at k=nz is the z+ top face; W at k=0 is the z- bottom face.
+    do islot=1,restas_slot_count
+      do j=restas_slot_j0(islot),restas_slot_j1(islot)
+        do i=restas_slot_i0(islot),restas_slot_i1(islot)
+          w(i,j,n(3))=0._rp
+          if(active) w(i,j,n(3))=restas_source_velocity(3)
+          qtop=qtop+max(0._rp,-w(i,j,n(3)))*face_area
+        enddo
+      enddo
+    enddo
+    qbottom=qtop
+    return_velocity=0._rp
+    if(qbottom.gt.0._rp) return_velocity=-qbottom/(real(n(1)*n(2),rp)*face_area)
+    do j=1,n(2)
+      do i=1,n(1)
+        w(i,j,0)=return_velocity
+      enddo
+    enddo
+  end subroutine restas_source_apply_velocity
+  !
+  subroutine restas_source_assert_velocity(n,step_index,dl,w)
+    implicit none
+    integer, intent(in) :: n(3),step_index
+    real(rp), intent(in) :: dl(3),w(0:,0:,0:)
+    integer :: islot,i,j
+    real(rp) :: face_area,qexpected,return_velocity,expected_w,tol
+    logical :: active
+    if(.not.restas_source_loaded) return
+    face_area=dl(1)*dl(2)
+    qexpected=0._rp
+    active=restas_source_active_at(step_index)
+    do islot=1,restas_slot_count
+      do j=restas_slot_j0(islot),restas_slot_j1(islot)
+        do i=restas_slot_i0(islot),restas_slot_i1(islot)
+          expected_w=0._rp
+          if(active) expected_w=restas_source_velocity(3)
+          tol=restas_input_tol*max(1._rp,abs(expected_w))
+          if(abs(w(i,j,n(3))-expected_w).gt.tol) &
+            error stop 'Current top velocity does not match projected source interval'
+          qexpected=qexpected+max(0._rp,-expected_w)*face_area
+        enddo
+      enddo
+    enddo
+    return_velocity=0._rp
+    if(qexpected.gt.0._rp) return_velocity=-qexpected/(real(n(1)*n(2),rp)*face_area)
+    do j=1,n(2)
+      do i=1,n(1)
+        tol=restas_input_tol*max(1._rp,abs(return_velocity))
+        if(abs(w(i,j,0)-return_velocity).gt.tol) &
+          error stop 'Current bottom return does not match projected source interval'
+      enddo
+    enddo
+  end subroutine restas_source_assert_velocity
+  !
+  subroutine restas_source_check_volume_pair(n,dl,dt,step_index,flux,w,qtop,qbottom)
+    implicit none
+    integer, intent(in) :: n(3),step_index
+    real(rp), intent(in) :: dl(3),dt,flux(0:,0:,0:)
+    real(rp), intent(in) :: w(0:,0:,0:)
+    real(rp), intent(out) :: qtop,qbottom
+    integer :: islot,i,j
+    real(rp) :: area,top_volume,qexpected,tol
+    qtop=0._rp
+    qbottom=0._rp
+    if(.not.restas_source_loaded) return
+    if(dt.le.0._rp) error stop 'Source return requires positive dt'
+    area=dl(1)*dl(2)
+    top_volume=0._rp
+    do islot=1,restas_slot_count
+      do j=restas_slot_j0(islot),restas_slot_j1(islot)
+        do i=restas_slot_i0(islot),restas_slot_i1(islot)
+          top_volume=top_volume+max(0._rp,-flux(i,j,n(3))*area)
+        enddo
+      enddo
+    enddo
+    qtop=top_volume/dt
+    qexpected=0._rp
+    if(restas_source_active_at(step_index)) then
+      do islot=1,restas_slot_count
+        qexpected=qexpected+real((restas_slot_i1(islot)-restas_slot_i0(islot)+1)* &
+          (restas_slot_j1(islot)-restas_slot_j0(islot)+1),rp)*area* &
+          abs(restas_source_velocity(3))
+      enddo
+    endif
+    tol=restas_input_tol*max(1._rp,abs(qexpected))
+    if(abs(qtop-qexpected).gt.tol) &
+      error stop 'Geometric liquid source flux differs from frozen total-volume schedule'
+    qbottom=0._rp
+    do j=1,n(2)
+      do i=1,n(1)
+        qbottom=qbottom-w(i,j,0)*area
+      enddo
+    enddo
+    if(abs(qbottom-qexpected).gt.tol) &
+      error stop 'Projected bottom return differs from frozen total-volume schedule'
+  end subroutine restas_source_check_volume_pair
+  !
+  subroutine restas_source_prepare_boundary(n,nh_u,step_index,vof,w,rho,mu)
+    use mod_param, only: rho1,rho2,mu1,mu2
+    implicit none
+    integer, intent(in) :: n(3),nh_u,step_index
+    real(rp), intent(inout) :: vof(0:,0:,0:)
+    real(rp), intent(in) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), optional, intent(inout) :: rho(0:,0:,0:),mu(0:,0:,0:)
+    integer :: i,j
+    real(rp) :: alpha_in
+    logical :: active,in_slot
+    if(.not.restas_source_loaded) return
+    if(present(rho).neqv.present(mu)) &
+      error stop 'Density and viscosity ghost updates must be paired'
+    active=restas_source_active_at(step_index)
+    ! z+ inflow: active slot is liquid; all other inflow is air.
+    ! Leave every outflow ghost from generic NN extrapolation untouched.
+    do j=1,n(2)
+      do i=1,n(1)
+        if(w(i,j,n(3)).lt.0._rp) then
+          in_slot=restas_source_cell(i,j)
+          alpha_in=0._rp
+          if(active.and.in_slot) alpha_in=1._rp
+          vof(i,j,n(3)+1)=alpha_in
+          if(present(rho)) then
+            rho(i,j,n(3)+1)=alpha_in*rho1+(1._rp-alpha_in)*rho2
+            mu(i,j,n(3)+1)=alpha_in*mu1+(1._rp-alpha_in)*mu2
+          endif
+        endif
+        ! z- reverse inflow is air; normal bottom return (w<0) is outflow.
+        if(w(i,j,0).gt.0._rp) then
+          vof(i,j,0)=0._rp
+          if(present(rho)) then
+            rho(i,j,0)=rho2
+            mu(i,j,0)=mu2
+          endif
+        endif
+      enddo
+    enddo
+  end subroutine restas_source_prepare_boundary
+  !
+  subroutine restas_source_write_header(path_prefix)
+    implicit none
+    character(len=*), intent(in) :: path_prefix
+    if(.not.restas_source_loaded) return
+    call restas_source_close_log()
+    open(newunit=restas_source_flux_unit,file=trim(path_prefix)//'_source-flux.csv',status='replace')
+    open(newunit=restas_boundary_unit,file=trim(path_prefix)//'_boundary-ledger.csv',status='replace')
+    open(newunit=restas_mass_unit,file=trim(path_prefix)//'_mass-ledger.csv',status='replace')
+    open(newunit=restas_velocity_unit,file=trim(path_prefix)//'_velocity-audit.csv',status='replace')
+    write(restas_source_flux_unit,'(A)') &
+      'interval,slot,requested_volume_m3,geometric_inward_volume_m3,requested_mass_kg,'// &
+      'applied_inward_mass_kg,requested_mom_x_kgm_s,requested_mom_y_kgm_s,'// &
+      'requested_mom_z_kgm_s,applied_mom_x_kgm_s,applied_mom_y_kgm_s,'// &
+      'applied_mom_z_kgm_s,slot_reverse_out_m3,offmask_in_m3,offmask_out_m3'
+    write(restas_boundary_unit,'(A)') &
+      'completed_state_index,xlow_in_m3,xlow_out_m3,xhigh_in_m3,xhigh_out_m3,'// &
+      'ylow_in_m3,ylow_out_m3,yhigh_in_m3,yhigh_out_m3,'// &
+      'zlow_in_m3,zlow_out_m3,zhigh_in_m3,zhigh_out_m3'
+    write(restas_mass_unit,'(A)') &
+      'state_index,time_s,box_liquid_kg,initial_liquid_kg,cumulative_boundary_in_kg,'// &
+      'cumulative_boundary_out_kg,residual_kg,net_boundary_liquid_m3,'// &
+      'xlow_in_kg,xlow_out_kg,xhigh_in_kg,xhigh_out_kg,'// &
+      'ylow_in_kg,ylow_out_kg,yhigh_in_kg,yhigh_out_kg,'// &
+      'zlow_in_kg,zlow_out_kg,zhigh_in_kg,zhigh_out_kg'
+    write(restas_velocity_unit,'(A)') &
+      'state_index,source_interval_index,time_s,top_in_m3_s,bottom_out_m3_s,net_boundary_m3_s,'// &
+      'integrated_divergence_m3_s,closure_m3_s,max_abs_div_s,l1_divergence_m3_s,'// &
+      'xlow_out_m3_s,xhigh_out_m3_s,ylow_out_m3_s,yhigh_out_m3_s,'// &
+      'zlow_out_m3_s,zhigh_out_m3_s'
+    restas_source_log_open=.true.
+  end subroutine restas_source_write_header
+  !
+  subroutine restas_source_begin_step()
+    implicit none
+    if(.not.restas_source_loaded) return
+    restas_step_in_volume=0._rp
+    restas_step_out_volume=0._rp
+  end subroutine restas_source_begin_step
+  !
+  subroutine restas_source_accumulate_boundary_flux(n,dl,dzf,dir,flux)
+    implicit none
+    integer, intent(in) :: n(3),dir
+    real(rp), intent(in) :: dl(3),dzf(:)
+    real(rp), intent(in) :: flux(0:,0:,0:)
+    integer :: i,j,k,low_face,high_face
+    real(rp) :: area,outward_volume
+    if(.not.restas_source_loaded) return
+    select case(dir)
+    case(1)
+      low_face=1
+      high_face=2
+      do k=1,n(3)
+        area=dl(2)*dzf(k)
+        do j=1,n(2)
+          call restas_source_add_boundary_volume(low_face,-flux(0,j,k)*area)
+          call restas_source_add_boundary_volume(high_face,flux(n(1),j,k)*area)
+        enddo
+      enddo
+    case(2)
+      low_face=3
+      high_face=4
+      do k=1,n(3)
+        area=dl(1)*dzf(k)
+        do i=1,n(1)
+          call restas_source_add_boundary_volume(low_face,-flux(i,0,k)*area)
+          call restas_source_add_boundary_volume(high_face,flux(i,n(2),k)*area)
+        enddo
+      enddo
+    case(3)
+      low_face=5
+      high_face=6
+      area=dl(1)*dl(2)
+      do j=1,n(2)
+        do i=1,n(1)
+          call restas_source_add_boundary_volume(low_face,-flux(i,j,0)*area)
+          call restas_source_add_boundary_volume(high_face,flux(i,j,n(3))*area)
+        enddo
+      enddo
+    case default
+      error stop 'Unsupported geometric flux direction'
+    end select
+  end subroutine restas_source_accumulate_boundary_flux
+  !
+  subroutine restas_source_add_boundary_volume(face,outward_volume)
+    implicit none
+    integer, intent(in) :: face
+    real(rp), intent(in) :: outward_volume
+    if(outward_volume.ge.0._rp) then
+      restas_step_out_volume(face)=restas_step_out_volume(face)+outward_volume
+    else
+      restas_step_in_volume(face)=restas_step_in_volume(face)-outward_volume
+    endif
+  end subroutine restas_source_add_boundary_volume
+  !
+  subroutine restas_source_record_flux(n,nh_u,dl,dt,step_index,flux,u,v,w)
+    use mod_param, only: rho1
+    implicit none
+    integer, intent(in) :: n(3),nh_u,step_index
+    real(rp), intent(in) :: dl(3),dt
+    real(rp), intent(in) :: flux(0:,0:,0:)
+    real(rp), intent(in) :: u(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: v(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    integer :: islot,i,j
+    real(rp) :: area,requested_volume,applied_volume,requested_mass,applied_mass
+    real(rp) :: requested_momentum(3),applied_momentum(3),dm,uf,vf,wf
+    real(rp) :: reverse_out,offmask_in,offmask_out
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    area=dl(1)*dl(2)
+    offmask_in=0._rp
+    offmask_out=0._rp
+    do j=1,n(2)
+      do i=1,n(1)
+        if(.not.restas_source_cell(i,j)) then
+          offmask_in=offmask_in+max(0._rp,-flux(i,j,n(3))*area)
+          offmask_out=offmask_out+max(0._rp, flux(i,j,n(3))*area)
+        endif
+      enddo
+    enddo
+    do islot=1,restas_slot_count
+      requested_volume=0._rp
+      if(restas_source_active_at(step_index)) then
+        requested_volume=real((restas_slot_i1(islot)-restas_slot_i0(islot)+1)* &
+          (restas_slot_j1(islot)-restas_slot_j0(islot)+1),rp)*area* &
+          abs(restas_source_velocity(3))*dt
+      endif
+      requested_mass=rho1*requested_volume
+      requested_momentum=requested_mass*restas_source_velocity
+      applied_volume=0._rp
+      applied_momentum=0._rp
+      reverse_out=0._rp
+      do j=restas_slot_j0(islot),restas_slot_j1(islot)
+        do i=restas_slot_i0(islot),restas_slot_i1(islot)
+          dm=rho1*max(0._rp,-flux(i,j,n(3))*area)
+          applied_volume=applied_volume+max(0._rp,-flux(i,j,n(3))*area)
+          reverse_out=reverse_out+max(0._rp,flux(i,j,n(3))*area)
+          ! U/V live at z cell centers; average interior and ghost to z+ face.
+          uf=0.5_rp*(u(i,j,n(3))+u(i,j,n(3)+1))
+          vf=0.5_rp*(v(i,j,n(3))+v(i,j,n(3)+1))
+          wf=w(i,j,n(3))
+          applied_momentum(1)=applied_momentum(1)+dm*uf
+          applied_momentum(2)=applied_momentum(2)+dm*vf
+          applied_momentum(3)=applied_momentum(3)+dm*wf
+        enddo
+      enddo
+      applied_mass=rho1*applied_volume
+      write(restas_source_flux_unit,'(I0,",",I0,13(",",ES24.16E3))') &
+        step_index,islot,requested_volume,applied_volume,requested_mass,applied_mass, &
+        requested_momentum(1),requested_momentum(2),requested_momentum(3), &
+        applied_momentum(1),applied_momentum(2),applied_momentum(3), &
+        reverse_out,offmask_in,offmask_out
+    enddo
+    flush(restas_source_flux_unit)
+  end subroutine restas_source_record_flux
+  !
+  subroutine restas_source_record_inventory(n,dl,dzf,vof,step_index,time)
+    use mod_param, only: rho1
+    implicit none
+    integer, intent(in) :: n(3),step_index
+    real(rp), intent(in) :: dl(3),dzf(:),time
+    real(rp), intent(in) :: vof(0:,0:,0:)
+    integer :: i,j,k,face
+    real(rp) :: box_mass,residual,net_volume,face_in_mass(6),face_out_mass(6)
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    box_mass=0._rp
+    do k=1,n(3)
+      do j=1,n(2)
+        do i=1,n(1)
+          box_mass=box_mass+rho1*vof(i,j,k)*dl(1)*dl(2)*dzf(k)
+        enddo
+      enddo
+    enddo
+    if(step_index.eq.0) then
+      restas_initial_mass=box_mass
+      restas_cumulative_in_mass=0._rp
+      restas_cumulative_out_mass=0._rp
+    else
+      restas_cumulative_in_mass=restas_cumulative_in_mass+rho1*sum(restas_step_in_volume)
+      restas_cumulative_out_mass=restas_cumulative_out_mass+rho1*sum(restas_step_out_volume)
+    endif
+    residual=restas_cumulative_in_mass-restas_cumulative_out_mass- &
+             (box_mass-restas_initial_mass)
+    face_in_mass=rho1*restas_step_in_volume
+    face_out_mass=rho1*restas_step_out_volume
+    net_volume=sum(restas_step_in_volume)-sum(restas_step_out_volume)
+    write(restas_boundary_unit,'(I0,12(",",ES24.16E3))') step_index, &
+      restas_step_in_volume(1),restas_step_out_volume(1), &
+      restas_step_in_volume(2),restas_step_out_volume(2), &
+      restas_step_in_volume(3),restas_step_out_volume(3), &
+      restas_step_in_volume(4),restas_step_out_volume(4), &
+      restas_step_in_volume(5),restas_step_out_volume(5), &
+      restas_step_in_volume(6),restas_step_out_volume(6)
+    write(restas_mass_unit,'(I0,19(",",ES24.16E3))') step_index,time,box_mass, &
+      restas_initial_mass,restas_cumulative_in_mass,restas_cumulative_out_mass,residual, &
+      net_volume,face_in_mass(1),face_out_mass(1),face_in_mass(2),face_out_mass(2), &
+      face_in_mass(3),face_out_mass(3),face_in_mass(4),face_out_mass(4), &
+      face_in_mass(5),face_out_mass(5),face_in_mass(6),face_out_mass(6)
+    flush(restas_boundary_unit)
+    flush(restas_mass_unit)
+  end subroutine restas_source_record_inventory
+  !
+  subroutine restas_source_record_velocity_audit(n,nh_u,dl,dzf,state_index,source_interval_index,time,u,v,w)
+    implicit none
+    integer, intent(in) :: n(3),nh_u,state_index,source_interval_index
+    real(rp), intent(in) :: dl(3),dzf(:),time
+    real(rp), intent(in) :: u(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: v(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    integer :: i,j,k
+    real(rp) :: face_out(6),net_boundary,div,div_integral,div_l1,div_max,cell_volume
+    real(rp) :: top_in,bottom_out,closure
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    face_out=0._rp
+    do k=1,n(3)
+      do j=1,n(2)
+        face_out(1)=face_out(1)-u(0,j,k)*dl(2)*dzf(k)
+        face_out(2)=face_out(2)+u(n(1),j,k)*dl(2)*dzf(k)
+      enddo
+    enddo
+    do k=1,n(3)
+      do i=1,n(1)
+        face_out(3)=face_out(3)-v(i,0,k)*dl(1)*dzf(k)
+        face_out(4)=face_out(4)+v(i,n(2),k)*dl(1)*dzf(k)
+      enddo
+    enddo
+    do j=1,n(2)
+      do i=1,n(1)
+        face_out(5)=face_out(5)-w(i,j,0)*dl(1)*dl(2)
+        face_out(6)=face_out(6)+w(i,j,n(3))*dl(1)*dl(2)
+      enddo
+    enddo
+    div_integral=0._rp
+    div_l1=0._rp
+    div_max=0._rp
+    do k=1,n(3)
+      cell_volume=dl(1)*dl(2)*dzf(k)
+      do j=1,n(2)
+        do i=1,n(1)
+          div=(u(i,j,k)-u(i-1,j,k))/dl(1)+ &
+              (v(i,j,k)-v(i,j-1,k))/dl(2)+ &
+              (w(i,j,k)-w(i,j,k-1))/dzf(k)
+          div_integral=div_integral+div*cell_volume
+          div_l1=div_l1+abs(div)*cell_volume
+          div_max=max(div_max,abs(div))
+        enddo
+      enddo
+    enddo
+    net_boundary=sum(face_out)
+    closure=div_integral-net_boundary
+    top_in=max(0._rp,-face_out(6))
+    bottom_out=max(0._rp,face_out(5))
+    write(restas_velocity_unit,'(I0,15(",",ES24.16E3))') state_index, &
+      real(source_interval_index,rp),time,top_in,bottom_out,net_boundary, &
+      div_integral,closure,div_max,div_l1,face_out
+    flush(restas_velocity_unit)
+  end subroutine restas_source_record_velocity_audit
+  !
+  subroutine restas_source_close_log()
+    implicit none
+    if(restas_source_log_open) then
+      close(restas_source_flux_unit)
+      close(restas_boundary_unit)
+      close(restas_mass_unit)
+      close(restas_velocity_unit)
+    endif
+    restas_source_log_open=.false.
+  end subroutine restas_source_close_log
