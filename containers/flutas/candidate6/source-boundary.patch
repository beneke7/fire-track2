+  subroutine restas_source_accumulate_boundary_flux(n,dl,dzf,dir,flux)
+    implicit none
+    integer, intent(in) :: n(3),dir
+    real(rp), intent(in) :: dl(3),dzf(0:)
+    real(rp), intent(in) :: flux(0:,0:,0:)
+    integer :: i,j,k,low_face,high_face
+    real(rp) :: area,outward_volume
+    if(.not.restas_source_loaded) return
+    select case(dir)
+    case(1)
+      low_face=1
+      high_face=2
+      do k=1,n(3)
+        area=dl(2)*dzf(k)
+        do j=1,n(2)
+          call restas_source_add_boundary_volume(low_face,-flux(0,j,k)*area)
+          call restas_source_add_boundary_volume(high_face,flux(n(1),j,k)*area)
+        enddo
+      enddo
+    case(2)
+      low_face=3
+      high_face=4
+      do k=1,n(3)
+        area=dl(1)*dzf(k)
+        do i=1,n(1)
+          call restas_source_add_boundary_volume(low_face,-flux(i,0,k)*area)
+          call restas_source_add_boundary_volume(high_face,flux(i,n(2),k)*area)
+        enddo
+      enddo
+    case(3)
+      low_face=5
+      high_face=6
+      area=dl(1)*dl(2)
+      do j=1,n(2)
+        do i=1,n(1)
+          call restas_source_add_boundary_volume(low_face,-flux(i,j,0)*area)
+          call restas_source_add_boundary_volume(high_face,flux(i,j,n(3))*area)
+        enddo
+      enddo
+    case default
+      error stop 'Unsupported geometric flux direction'
+    end select
+  end subroutine restas_source_accumulate_boundary_flux
+  !
+  subroutine restas_source_add_boundary_volume(face,outward_volume)
+    implicit none
+    integer, intent(in) :: face
+    real(rp), intent(in) :: outward_volume
+    if(outward_volume.ge.0._rp) then
+      restas_step_out_volume(face)=restas_step_out_volume(face)+outward_volume
+    else
+      restas_step_in_volume(face)=restas_step_in_volume(face)-outward_volume
+    endif
+  end subroutine restas_source_add_boundary_volume
+  !
+  subroutine restas_source_record_flux(n,nh_u,dl,dt,step_index,flux,u,v,w)
+    use mod_param, only: rho1
+    implicit none
+    integer, intent(in) :: n(3),nh_u,step_index
+    real(rp), intent(in) :: dl(3),dt
+    real(rp), intent(in) :: flux(0:,0:,0:)
+    real(rp), intent(in) :: u(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: v(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    integer :: islot,i,j
+    real(rp) :: area,requested_volume,applied_volume,requested_mass,applied_mass
+    real(rp) :: requested_momentum(3),applied_momentum(3),dm,uf,vf,wf
+    real(rp) :: reverse_out,offmask_in,offmask_out
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    area=dl(1)*dl(2)
+    offmask_in=0._rp
+    offmask_out=0._rp
+    do j=1,n(2)
+      do i=1,n(1)
+        if(.not.restas_source_cell(i,j)) then
+          offmask_in=offmask_in+max(0._rp,-flux(i,j,n(3))*area)
+          offmask_out=offmask_out+max(0._rp, flux(i,j,n(3))*area)
+        endif
+      enddo
+    enddo
+    write(restas_offmask_unit,'(I0,2(",",ES24.16E3))') step_index,offmask_in,offmask_out
+    flush(restas_offmask_unit)
+    do islot=1,restas_slot_count
+      requested_volume=0._rp
+      if(restas_source_active_at(step_index)) then
+        requested_volume=real((restas_slot_i1(islot)-restas_slot_i0(islot)+1)* &
+          (restas_slot_j1(islot)-restas_slot_j0(islot)+1),rp)*area* &
+          abs(restas_source_velocity(3))*dt
+      endif
+      requested_mass=rho1*requested_volume
+      requested_momentum=requested_mass*restas_source_velocity
+      applied_volume=0._rp
+      applied_momentum=0._rp
+      reverse_out=0._rp
+      do j=restas_slot_j0(islot),restas_slot_j1(islot)
+        do i=restas_slot_i0(islot),restas_slot_i1(islot)
+          dm=rho1*max(0._rp,-flux(i,j,n(3))*area)
+          applied_volume=applied_volume+max(0._rp,-flux(i,j,n(3))*area)
+          reverse_out=reverse_out+max(0._rp,flux(i,j,n(3))*area)
+          ! U/V live at z cell centers; average interior and ghost to z+ face.
+          uf=0.5_rp*(u(i,j,n(3))+u(i,j,n(3)+1))
+          vf=0.5_rp*(v(i,j,n(3))+v(i,j,n(3)+1))
+          wf=w(i,j,n(3))
+          applied_momentum(1)=applied_momentum(1)+dm*uf
+          applied_momentum(2)=applied_momentum(2)+dm*vf
+          applied_momentum(3)=applied_momentum(3)+dm*wf
+        enddo
+      enddo
+      applied_mass=rho1*applied_volume
+      write(restas_source_flux_unit,'(I0,",",I0,11(",",ES24.16E3))') &
+        step_index,islot,requested_volume,applied_volume,requested_mass,applied_mass, &
+        requested_momentum(1),requested_momentum(2),requested_momentum(3), &
+        applied_momentum(1),applied_momentum(2),applied_momentum(3),reverse_out
+    enddo
+    flush(restas_source_flux_unit)
+  end subroutine restas_source_record_flux
+  !
+  subroutine restas_source_record_inventory(n,dl,dzf,vof,step_index,time)
+    use mod_param, only: rho1
+    implicit none
+    integer, intent(in) :: n(3),step_index
+    real(rp), intent(in) :: dl(3),dzf(0:),time
+    real(rp), intent(in) :: vof(0:,0:,0:)
+    integer :: i,j,k,face
+    real(rp) :: box_mass,residual,net_volume,face_in_mass(6),face_out_mass(6)
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    box_mass=0._rp
+    do k=1,n(3)
+      do j=1,n(2)
+        do i=1,n(1)
+          box_mass=box_mass+rho1*vof(i,j,k)*dl(1)*dl(2)*dzf(k)
+        enddo
+      enddo
+    enddo
+    if(step_index.eq.0) then
+      restas_initial_mass=box_mass
+      restas_cumulative_in_mass=0._rp
+      restas_cumulative_out_mass=0._rp
+    else
+      restas_cumulative_in_mass=restas_cumulative_in_mass+rho1*sum(restas_step_in_volume)
+      restas_cumulative_out_mass=restas_cumulative_out_mass+rho1*sum(restas_step_out_volume)
+    endif
+    residual=restas_cumulative_in_mass-restas_cumulative_out_mass- &
+             (box_mass-restas_initial_mass)
+    face_in_mass=rho1*restas_step_in_volume
+    face_out_mass=rho1*restas_step_out_volume
+    net_volume=sum(restas_step_in_volume)-sum(restas_step_out_volume)
+    write(restas_boundary_unit,'(I0,12(",",ES24.16E3))') step_index, &
+      restas_step_in_volume(1),restas_step_out_volume(1), &
+      restas_step_in_volume(2),restas_step_out_volume(2), &
+      restas_step_in_volume(3),restas_step_out_volume(3), &
+      restas_step_in_volume(4),restas_step_out_volume(4), &
+      restas_step_in_volume(5),restas_step_out_volume(5), &
+      restas_step_in_volume(6),restas_step_out_volume(6)
+    write(restas_mass_unit,'(I0,19(",",ES24.16E3))') step_index,time,box_mass, &
+      restas_initial_mass,restas_cumulative_in_mass,restas_cumulative_out_mass,residual, &
+      net_volume,face_in_mass(1),face_out_mass(1),face_in_mass(2),face_out_mass(2), &
+      face_in_mass(3),face_out_mass(3),face_in_mass(4),face_out_mass(4), &
+      face_in_mass(5),face_out_mass(5),face_in_mass(6),face_out_mass(6)
+    flush(restas_boundary_unit)
+    flush(restas_mass_unit)
+  end subroutine restas_source_record_inventory
+  !
+  subroutine restas_source_record_velocity_audit(n,nh_u,dl,dzf,dt,state_index, &
+                                                    source_profile_interval,time,vof,u,v,w)
+    implicit none
+    integer, intent(in) :: n(3),nh_u,state_index,source_profile_interval
+    real(rp), intent(in) :: dl(3),dzf(0:),dt,time
+    real(rp), intent(in) :: vof(0:,0:,0:)
+    real(rp), intent(in) :: u(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: v(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    integer :: i,j,k,interface_cell_count,interface_courant_defined,total_cell_count
+    real(rp) :: face_out(6),net_boundary,div,div_integral,div_l1,div_max,cell_volume
+    real(rp) :: top_in,bottom_out,closure,ux,uy,uz,vx,vy,vz,wx,wy,wz
+    real(rp) :: dtix,dtiy,dtiz,cell_courant,global_courant,interface_courant
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    face_out=0._rp
+    do k=1,n(3)
+      do j=1,n(2)
+        face_out(1)=face_out(1)-u(0,j,k)*dl(2)*dzf(k)
+        face_out(2)=face_out(2)+u(n(1),j,k)*dl(2)*dzf(k)
+      enddo
+    enddo
+    do k=1,n(3)
+      do i=1,n(1)
+        face_out(3)=face_out(3)-v(i,0,k)*dl(1)*dzf(k)
+        face_out(4)=face_out(4)+v(i,n(2),k)*dl(1)*dzf(k)
+      enddo
+    enddo
+    do j=1,n(2)
+      do i=1,n(1)
+        face_out(5)=face_out(5)-w(i,j,0)*dl(1)*dl(2)
+        face_out(6)=face_out(6)+w(i,j,n(3))*dl(1)*dl(2)
+      enddo
+    enddo
+    div_integral=0._rp
+    div_l1=0._rp
+    div_max=0._rp
+    global_courant=0._rp
+    interface_courant=0._rp
+    interface_cell_count=0
+    total_cell_count=product(n)
+    do k=1,n(3)
+      cell_volume=dl(1)*dl(2)*dzf(k)
+      do j=1,n(2)
+        do i=1,n(1)
+          div=(u(i,j,k)-u(i-1,j,k))/dl(1)+ &
+              (v(i,j,k)-v(i,j-1,k))/dl(2)+ &
+              (w(i,j,k)-w(i,j,k-1))/dzf(k)
+          div_integral=div_integral+div*cell_volume
+          div_l1=div_l1+abs(div)*cell_volume
+          div_max=max(div_max,abs(div))
+          ! Preserve the inherited audit's division by dzf(k) in all directions.
+          ! This is distinct from the v1.2 timestep restriction, which uses the
+          ! captured dzfi(k)/dzci(k) operands and source-order multiplication.
+          ! These are advective Courant diagnostics, not the complete stability limit.
+          ux=abs(u(i,j,k))
+          vx=0.25_rp*abs(v(i,j,k)+v(i,j-1,k)+v(i+1,j,k)+v(i+1,j-1,k))
+          wx=0.25_rp*abs(w(i,j,k)+w(i,j,k-1)+w(i+1,j,k)+w(i+1,j,k-1))
+          dtix=ux/dl(1)+vx/dl(2)+wx/dzf(k)
+          uy=0.25_rp*abs(u(i,j,k)+u(i,j+1,k)+u(i-1,j+1,k)+u(i-1,j,k))
+          vy=abs(v(i,j,k))
+          wy=0.25_rp*abs(w(i,j,k)+w(i,j+1,k)+w(i,j+1,k-1)+w(i,j,k-1))
+          dtiy=uy/dl(1)+vy/dl(2)+wy/dzf(k)
+          uz=0.25_rp*abs(u(i,j,k)+u(i-1,j,k)+u(i-1,j,k+1)+u(i,j,k+1))
+          vz=0.25_rp*abs(v(i,j,k)+v(i,j-1,k)+v(i,j-1,k+1)+v(i,j,k+1))
+          wz=abs(w(i,j,k))
+          dtiz=uz/dl(1)+vz/dl(2)+wz/dzf(k)
+          cell_courant=dt*max(dtix,dtiy,dtiz)
+          global_courant=max(global_courant,cell_courant)
+          if(vof(i,j,k).gt.0._rp.and.vof(i,j,k).lt.1._rp) then
+            interface_cell_count=interface_cell_count+1
+            interface_courant=max(interface_courant,cell_courant)
+          endif
+        enddo
+      enddo
+    enddo
+    interface_courant_defined=0
+    if(interface_cell_count.gt.0) interface_courant_defined=1
+    net_boundary=sum(face_out)
+    closure=div_integral-net_boundary
+    top_in=max(0._rp,-face_out(6))
+    bottom_out=max(0._rp,face_out(5))
+    write(restas_velocity_unit,'(I0,",",I0,2(",",ES24.16E3),",",I0,",",ES24.16E3,",",I0,",",I0,14(",",ES24.16E3))') &
+      state_index,source_profile_interval,time,dt,total_cell_count,global_courant, &
+      interface_cell_count,interface_courant_defined,interface_courant,top_in,bottom_out, &
+      net_boundary,div_integral,closure,div_max,div_l1,face_out
+    flush(restas_velocity_unit)
+  end subroutine restas_source_record_velocity_audit
+  !
+  subroutine restas_source_scan_reset(summary)
+    implicit none
+    type(restas_scan_summary), intent(out) :: summary
+    summary=restas_scan_summary()
+  end subroutine restas_source_scan_reset
+  !
+  subroutine restas_source_scan_add(summary,i,j,k,expected,observed)
+    use, intrinsic :: ieee_arithmetic, only: ieee_is_finite,ieee_is_nan
+    implicit none
+    type(restas_scan_summary), intent(inout) :: summary
+    integer, intent(in) :: i,j,k
+    real(rp), intent(in) :: expected,observed
+    real(rp) :: error_value
+    logical :: finite_pair,bad
+    summary%scanned_cells=summary%scanned_cells+1
+    finite_pair=ieee_is_finite(expected).and.ieee_is_finite(observed)
+    bad=.not.finite_pair
+    if(finite_pair) then
+      error_value=abs(observed-expected)
+      if(observed.ne.expected) then
+        summary%mismatch_count=summary%mismatch_count+1
+        bad=.true.
+      endif
+      if(.not.ieee_is_finite(error_value)) then
+        summary%max_abs_error=error_value
+        summary%max_abs_error_overflow=.true.
+        bad=.true.
+      elseif(.not.summary%max_abs_error_overflow) then
+        summary%max_abs_error=max(summary%max_abs_error,error_value)
+      endif
+    else
+      summary%nonfinite_count=summary%nonfinite_count+1
+    endif
+    if(bad.and..not.summary%has_first_bad) then
+      summary%has_first_bad=.true.
+      summary%first_bad_i=i
+      summary%first_bad_j=j
+      summary%first_bad_k=k
+      summary%first_expected_nonfinite=.not.ieee_is_finite(expected)
+      if(summary%first_expected_nonfinite) then
+        if(ieee_is_nan(expected)) then
+          summary%first_expected_token='NaN'
+        elseif(expected.gt.0._rp) then
+          summary%first_expected_token='+Inf'
+        else
+          summary%first_expected_token='-Inf'
+        endif
+      else
+        summary%first_expected=expected
+        summary%first_expected_token=''
+      endif
+      summary%first_observed_nonfinite=.not.ieee_is_finite(observed)
+      if(.not.summary%first_observed_nonfinite) then
+        summary%first_observed=observed
+        summary%first_observed_token=''
+      else
+        if(ieee_is_nan(observed)) then
+          summary%first_observed_token='NaN'
+        elseif(observed.gt.0._rp) then
+          summary%first_observed_token='+Inf'
+        else
+          summary%first_observed_token='-Inf'
+        endif
+      endif
+    endif
+  end subroutine restas_source_scan_add
+  !
+  logical function restas_source_scan_failed(summary)
+    implicit none
+    type(restas_scan_summary), intent(in) :: summary
+    restas_source_scan_failed=(summary%mismatch_count.gt.0.or.summary%nonfinite_count.gt.0.or. &
+                               summary%max_abs_error_overflow)
+  end function restas_source_scan_failed
+  !
+  subroutine restas_source_write_audit_row(unit,state_index,transport_interval_index, &
+      stage_id,face,source_class,quantity,summary)
+    implicit none
+    integer, intent(in) :: unit,state_index,transport_interval_index
+    character(len=*), intent(in) :: stage_id,face,source_class,quantity
+    type(restas_scan_summary), intent(in) :: summary
+    character(len=64) :: first_i,first_j,first_k,expected_text,observed_text
+    character(len=64) :: error_text
+    if(.not.summary%has_first_bad) then
+      first_i='not_applicable'
+      first_j='not_applicable'
+      first_k='not_applicable'
+      expected_text='not_applicable'
+      observed_text='not_applicable'
+    else
+      write(first_i,'(I0)') summary%first_bad_i
+      write(first_j,'(I0)') summary%first_bad_j
+      write(first_k,'(I0)') summary%first_bad_k
+      if(summary%first_expected_nonfinite) then
+        expected_text=summary%first_expected_token
+      else
+        expected_text=restas_source_real_text(summary%first_expected)
+      endif
+      if(summary%first_observed_nonfinite) then
+        observed_text=summary%first_observed_token
+      else
+        observed_text=restas_source_real_text(summary%first_observed)
+      endif
+    endif
+    if(summary%max_abs_error_overflow) then
+      error_text='+Inf'
+    else
+      error_text=restas_source_real_text(summary%max_abs_error)
+    endif
+    write(unit,'(I0,",",I0,4(",",A),",",I0,",",I0,",",I0,",",A,5(",",A))') &
+      state_index,transport_interval_index,trim(stage_id),trim(face), &
+      trim(source_class),trim(quantity),summary%scanned_cells, &
+      summary%mismatch_count,summary%nonfinite_count,trim(error_text), &
+      trim(first_i),trim(first_j),trim(first_k),trim(expected_text),trim(observed_text)
+  end subroutine restas_source_write_audit_row
+  !
+  function restas_source_real_text(value) result(text)
+    implicit none
+    real(rp), intent(in) :: value
+    character(len=64) :: text
+    character(len=24) :: buffer
+    if(value.eq.0._rp) then
+      text='0'
+    else
+      write(buffer,'(ES24.16E3)') value
+      text=adjustl(buffer)
+    endif
+  end function restas_source_real_text
+  !
+  subroutine restas_source_json_number(unit,key,value,comma)
+    implicit none
+    integer, intent(in) :: unit
+    character(len=*), intent(in) :: key
+    real(rp), intent(in) :: value
+    character(len=1), intent(in) :: comma
+    character(len=64) :: text
+    text=restas_source_real_text(value)
+    write(unit,'(A)',advance='no') '"'//trim(key)//'":"'//trim(text)//'"'//comma
+  end subroutine restas_source_json_number
+  !
+  subroutine restas_source_json_array(unit,key,values,comma)
+    implicit none
+    integer, intent(in) :: unit
+    character(len=*), intent(in) :: key
+    real(rp), intent(in) :: values(0:)
+    character(len=1), intent(in) :: comma
+    integer :: idx
+    write(unit,'(A)',advance='no') '"'//trim(key)//'":['
+    do idx=lbound(values,1),ubound(values,1)
+      if(idx.gt.lbound(values,1)) write(unit,'(A)',advance='no') ','
+      write(unit,'(A)',advance='no') '"'//trim(restas_source_real_text(values(idx)))//'"'
+    enddo
+    write(unit,'(A)') ']'//comma
+  end subroutine restas_source_json_array
+  !
+  subroutine restas_source_capture_timestep_inputs(time,fixed_step,spacing,inverse_spacing, &
+      dzc,dzf,dzci,dzfi)
+    use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+    use mod_param, only: time_scheme,pi,rho1,rho2,mu1,mu2,sigma,small,cfl_c,cfl_d
+    implicit none
+    real(rp), intent(in) :: time,fixed_step,spacing(3),inverse_spacing(3)
+    real(rp), intent(in) :: dzc(0:),dzf(0:),dzci(0:),dzfi(0:)
+    integer :: unit,ierr,k
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    if(restas_runtime_inputs_written) return
+    if(trim(time_scheme).ne.'ab2') error stop 'Candidate5 runtime inputs require time_scheme=ab2'
+    if(size(dzc).ne.42.or.size(dzf).ne.42.or.size(dzci).ne.42.or.size(dzfi).ne.42) &
+      error stop 'Candidate5 runtime vertical arrays must cover indices 0..41'
+    if(.not.ieee_is_finite(time).or.any(.not.ieee_is_finite(spacing)).or. &
+       any(.not.ieee_is_finite(inverse_spacing)).or.any(.not.ieee_is_finite(dzc)).or. &
+       any(.not.ieee_is_finite(dzf)).or.any(.not.ieee_is_finite(dzci)).or. &
+       any(.not.ieee_is_finite(dzfi))) &
+      error stop 'Candidate5 runtime timestep inputs contain a non-finite value'
+    if(any(spacing.le.0._rp).or.any(inverse_spacing.le.0._rp).or. &
+       any(dzc.le.0._rp).or.any(dzf.le.0._rp).or. &
+       any(dzci.le.0._rp).or.any(dzfi.le.0._rp)) &
+      error stop 'Candidate5 timestep spacings and inverses must be positive'
+    if(any(inverse_spacing.ne.1._rp/spacing)) &
+      error stop 'Candidate5 scalar inverse spacing differs from pinned initialization'
+    if(any(dzci.ne.1._rp/dzc).or.any(dzfi.ne.1._rp/dzf)) &
+      error stop 'Candidate5 vertical inverse spacing differs from pinned initialization'
+    restas_time_start=time
+    restas_time_fixed_step=fixed_step
+    open(newunit=unit,file=trim(restas_output_prefix)//'_timestep-inputs.json', &
+      status='new',action='write',iostat=ierr)
+    if(ierr.ne.0) error stop 'Cannot create candidate5 runtime timestep inputs without overwrite'
+    write(unit,'(A)') '{'
+    call restas_source_json_number(unit,'cfl_c',cfl_c,',')
+    call restas_source_json_number(unit,'cfl_d',cfl_d,',')
+    call restas_source_json_number(unit,'dx_m',spacing(1),',')
+    call restas_source_json_number(unit,'dxi_m_inv',inverse_spacing(1),',')
+    call restas_source_json_number(unit,'dy_m',spacing(2),',')
+    call restas_source_json_number(unit,'dyi_m_inv',inverse_spacing(2),',')
+    call restas_source_json_number(unit,'dz_m',spacing(3),',')
+    call restas_source_json_array(unit,'dzc_m',dzc,',')
+    call restas_source_json_array(unit,'dzci_m_inv',dzci,',')
+    call restas_source_json_array(unit,'dzf_m',dzf,',')
+    call restas_source_json_array(unit,'dzfi_m_inv',dzfi,',')
+    call restas_source_json_number(unit,'dzi_m_inv',inverse_spacing(3),',')
+    call restas_source_json_number(unit,'fixed_step_factor',restas_fixed_step_factor,',')
+    call restas_source_json_number(unit,'fixed_step_s',fixed_step,',')
+    write(unit,'(A)',advance='no') '"gravity_m_s2":['
+    do k=1,3
+      if(k.gt.1) write(unit,'(A)',advance='no') ','
+      write(unit,'(A)',advance='no') '"'//trim(restas_source_real_text(restas_gravity(k)))//'"'
+    enddo
+    write(unit,'(A)') '],'
+    call restas_source_json_number(unit,'machine_epsilon',epsilon(pi),',')
+    call restas_source_json_number(unit,'mu1_pa_s',mu1,',')
+    call restas_source_json_number(unit,'mu2_pa_s',mu2,',')
+    write(unit,'(A,I0,A)') '"precision_digits":',precision(pi),','
+    write(unit,'(A,I0,A)') '"real_kind":',kind(0._rp),','
+    call restas_source_json_number(unit,'rho1_kg_m3',rho1,',')
+    call restas_source_json_number(unit,'rho2_kg_m3',rho2,',')
+    call restas_source_json_number(unit,'sigma_n_m',sigma,',')
+    call restas_source_json_number(unit,'small_s_inv',small,',')
+    write(unit,'(A)',advance='no') '"time_scheme":"'//trim(time_scheme)//'",'
+    call restas_source_json_number(unit,'time_start_s',time,' ')
+    write(unit,'(A)') '}'
+    flush(unit)
+    close(unit)
+    restas_runtime_inputs_written=.true.
+  end subroutine restas_source_capture_timestep_inputs
+  !
+  subroutine restas_source_record_phase_stage(n,nh_u,state_index,transport_interval_index, &
+                                               stage_id,vof,w,rho,mu)
+    use mod_param, only: rho1,rho2,mu1,mu2
+    implicit none
+    integer, intent(in) :: n(3),nh_u,state_index,transport_interval_index
+    character(len=*), intent(in) :: stage_id
+    real(rp), intent(in) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(inout) :: vof(0:,0:,0:)
+    real(rp), intent(inout) :: rho(0:,0:,0:),mu(0:,0:,0:)
+    integer, parameter :: npair=8,nprop=3
+    integer, parameter :: alpha_id=1,rho_id=2,mu_id=3
+    integer, parameter :: bottom_pair=5,active_pair=6,inactive_pair=7,offmask_pair=8
+    character(len=8), parameter :: face_name(npair) = &
+      [character(len=8) :: 'xlow','xhigh','ylow','yhigh', &
+       'zlow','zhigh','zhigh','zhigh']
+    character(len=16), parameter :: class_name(npair) = &
+      [character(len=16) :: 'periodic','periodic','periodic','periodic', &
+       'bottom_return','active_slot','inactive_slot','top_offmask']
+    character(len=5), parameter :: prop_name(nprop) = &
+      [character(len=5) :: 'alpha','rho','mu']
+    type(restas_scan_summary) :: summary(npair,nprop)
+    integer :: pair,p,i,j,k,jwrap,pair_id,nprop_stage
+    real(rp) :: expected_alpha,expected_value
+    logical :: active,any_failed,inflow
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    active=restas_source_active_at(transport_interval_index)
+    select case(trim(stage_id))
+    case('pre_vof_x','pre_vof_y','pre_vof_z')
+      nprop_stage=1
+    case('pre_momentum')
+      nprop_stage=nprop
+    case default
+      error stop 'Candidate5 phase audit received an unknown stage'
+    end select
+    if(state_index.ne.transport_interval_index) &
+      error stop 'Candidate5 phase audit state must equal its transport interval'
+    do pair=1,npair
+      do p=1,nprop
+        call restas_source_scan_reset(summary(pair,p))
+      enddo
+    enddo
+    ! The scalar arrays have one explicit ghost cell (0 and n+1) on each side.
+    ! X owns edge/corner ghosts; Y scans the remaining shell; Z scans interior i,j.
+    do j=0,n(2)+1
+      do k=0,n(3)+1
+        jwrap=j
+        if(jwrap.eq.0) jwrap=n(2)
+        if(jwrap.eq.n(2)+1) jwrap=1
+        call restas_source_scan_add(summary(1,alpha_id),0,j,k,vof(n(1),jwrap,k),vof(0,j,k))
+        call restas_source_scan_add(summary(2,alpha_id),n(1)+1,j,k,vof(1,jwrap,k),vof(n(1)+1,j,k))
+        if(nprop_stage.eq.nprop) then
+          call restas_source_scan_add(summary(1,rho_id),0,j,k,rho(n(1),jwrap,k),rho(0,j,k))
+          call restas_source_scan_add(summary(1,mu_id),0,j,k,mu(n(1),jwrap,k),mu(0,j,k))
+          call restas_source_scan_add(summary(2,rho_id),n(1)+1,j,k,rho(1,jwrap,k),rho(n(1)+1,j,k))
+          call restas_source_scan_add(summary(2,mu_id),n(1)+1,j,k,mu(1,jwrap,k),mu(n(1)+1,j,k))
+        endif
+      enddo
+    enddo
+    do i=1,n(1)
+      do k=0,n(3)+1
+        call restas_source_scan_add(summary(3,alpha_id),i,0,k,vof(i,n(2),k),vof(i,0,k))
+        call restas_source_scan_add(summary(4,alpha_id),i,n(2)+1,k,vof(i,1,k),vof(i,n(2)+1,k))
+        if(nprop_stage.eq.nprop) then
+          call restas_source_scan_add(summary(3,rho_id),i,0,k,rho(i,n(2),k),rho(i,0,k))
+          call restas_source_scan_add(summary(3,mu_id),i,0,k,mu(i,n(2),k),mu(i,0,k))
+          call restas_source_scan_add(summary(4,rho_id),i,n(2)+1,k,rho(i,1,k),rho(i,n(2)+1,k))
+          call restas_source_scan_add(summary(4,mu_id),i,n(2)+1,k,mu(i,1,k),mu(i,n(2)+1,k))
+        endif
+      enddo
+    enddo
+    do i=1,n(1)
+      do j=1,n(2)
+        inflow=w(i,j,0).gt.0._rp
+        expected_alpha=vof(i,j,1)
+        expected_value=rho(i,j,1)
+        if(inflow) then
+          expected_alpha=0._rp
+          expected_value=rho2
+        endif
+        call restas_source_scan_add(summary(bottom_pair,alpha_id),i,j,0, &
+          expected_alpha,vof(i,j,0))
+        if(nprop_stage.eq.nprop) then
+          call restas_source_scan_add(summary(bottom_pair,rho_id),i,j,0, &
+            expected_value,rho(i,j,0))
+          expected_value=mu(i,j,1)
+          if(inflow) expected_value=mu2
+          call restas_source_scan_add(summary(bottom_pair,mu_id),i,j,0, &
+            expected_value,mu(i,j,0))
+        endif
+        pair_id=offmask_pair
+        if(restas_source_cell(i,j)) then
+          pair_id=inactive_pair
+          if(active) pair_id=active_pair
+        endif
+        inflow=w(i,j,n(3)).lt.0._rp
+        expected_alpha=vof(i,j,n(3))
+        expected_value=rho(i,j,n(3))
+        if(inflow) then
+          expected_alpha=0._rp
+          if(pair_id.eq.active_pair) expected_alpha=1._rp
+          expected_value=expected_alpha*rho1+(1._rp-expected_alpha)*rho2
+        endif
+        call restas_source_scan_add(summary(pair_id,alpha_id),i,j,n(3)+1, &
+          expected_alpha,vof(i,j,n(3)+1))
+        if(nprop_stage.eq.nprop) then
+          call restas_source_scan_add(summary(pair_id,rho_id),i,j,n(3)+1, &
+            expected_value,rho(i,j,n(3)+1))
+          expected_value=mu(i,j,n(3))
+          if(inflow) expected_value=expected_alpha*mu1+(1._rp-expected_alpha)*mu2
+          call restas_source_scan_add(summary(pair_id,mu_id),i,j,n(3)+1, &
+            expected_value,mu(i,j,n(3)+1))
+        endif
+      enddo
+    enddo
+    any_failed=.false.
+    do pair=1,npair
+      do p=1,nprop_stage
+        call restas_source_write_audit_row(restas_phase_stage_unit,state_index, &
+          transport_interval_index,stage_id,face_name(pair),class_name(pair), &
+          prop_name(p),summary(pair,p))
+        any_failed=any_failed.or.restas_source_scan_failed(summary(pair,p))
+      enddo
+    enddo
+    flush(restas_phase_stage_unit)
+    if(any_failed) error stop 'Candidate5 phase/property ghost scan failed'
+  end subroutine restas_source_record_phase_stage
+  !
+  subroutine restas_source_record_velocity_stage(n,nh_u,dl,state_index, &
+      transport_interval_index,stage_id,u,v,w)
+    implicit none
+    integer, intent(in) :: n(3),nh_u,state_index,transport_interval_index
+    real(rp), intent(in) :: dl(3)
+    character(len=*), intent(in) :: stage_id
+    real(rp), intent(in) :: u(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: v(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    integer, parameter :: npair=4,ncomp=3
+    integer, parameter :: active_pair=1,inactive_pair=2,offmask_pair=3,bottom_pair=4
+    character(len=8), parameter :: face_name(npair) = &
+      [character(len=8) :: 'zhigh','zhigh','zhigh','zlow']
+    character(len=16), parameter :: class_name(npair) = &
+      [character(len=16) :: 'active_slot','inactive_slot','top_offmask','bottom_return']
+    character(len=1), parameter :: component_name(ncomp) = ['u','v','w']
+    type(restas_scan_summary) :: summary(npair,ncomp)
+    integer :: pair,q,i,j
+    real(rp) :: expected,return_velocity,top_volume,area,applied
+    logical :: active,any_failed
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    select case(trim(stage_id))
+    case('initial_u0')
+      if(state_index.ne.0.or.transport_interval_index.ne.-1) &
+        error stop 'Candidate5 initial velocity audit must identify U0 and interval -1'
+    case('pre_vof')
+      if(state_index.ne.transport_interval_index) &
+        error stop 'Candidate5 pre-VOF velocity audit must identify U_k and interval k'
+    case('projection_override','corrected_endpoint')
+      if(state_index.ne.transport_interval_index+1) &
+        error stop 'Candidate5 endpoint velocity audit must identify U_(k+1) and interval k'
+    case default
+      error stop 'Candidate5 velocity audit received an unknown stage'
+    end select
+    active=restas_source_active_at(state_index)
+    do pair=1,npair
+      do q=1,ncomp
+        call restas_source_scan_reset(summary(pair,q))
+      enddo
+    enddo
+    area=dl(1)*dl(2)
+    top_volume=0._rp
+    if(active) then
+      do pair=1,restas_slot_count
+        do j=restas_slot_j0(pair),restas_slot_j1(pair)
+          do i=restas_slot_i0(pair),restas_slot_i1(pair)
+            top_volume=top_volume+max(0._rp,-restas_source_velocity(3))*area
+          enddo
+        enddo
+      enddo
+    endif
+    return_velocity=0._rp
+    if(top_volume.gt.0._rp) &
+      return_velocity=-top_volume/(real(n(1)*n(2),rp)*area)
+    ! Tangential z-face values are the boundary average of interior and ghost.
+    do i=1-nh_u,n(1)+nh_u
+      do j=1-nh_u,n(2)+nh_u
+        pair=offmask_pair
+        if(restas_source_cell(i,j)) then
+          pair=inactive_pair
+          if(active) pair=active_pair
+        endif
+        expected=restas_background_velocity(1)
+        if(pair.eq.active_pair) expected=restas_source_velocity(1)
+        applied=2._rp*expected-u(i,j,n(3))
+        call restas_source_scan_add(summary(pair,1),i,j,n(3)+1, &
+          applied,u(i,j,n(3)+1))
+        expected=restas_background_velocity(2)
+        if(pair.eq.active_pair) expected=restas_source_velocity(2)
+        applied=2._rp*expected-v(i,j,n(3))
+        call restas_source_scan_add(summary(pair,2),i,j,n(3)+1, &
+          applied,v(i,j,n(3)+1))
+        expected=0._rp
+        if(active.and.pair.eq.active_pair) expected=restas_source_velocity(3)
+        call restas_source_scan_add(summary(pair,3),i,j,n(3),expected,w(i,j,n(3)))
+        expected=restas_background_velocity(1)
+        applied=2._rp*expected-u(i,j,1)
+        call restas_source_scan_add(summary(bottom_pair,1),i,j,0, &
+          applied,u(i,j,0))
+        expected=restas_background_velocity(2)
+        applied=2._rp*expected-v(i,j,1)
+        call restas_source_scan_add(summary(bottom_pair,2),i,j,0, &
+          applied,v(i,j,0))
+        call restas_source_scan_add(summary(bottom_pair,3),i,j,0, &
+          return_velocity,w(i,j,0))
+      enddo
+    enddo
+    any_failed=.false.
+    do pair=1,npair
+      do q=1,ncomp
+        call restas_source_write_audit_row(restas_velocity_stage_unit,state_index, &
+          transport_interval_index,stage_id,face_name(pair),class_name(pair), &
+          component_name(q),summary(pair,q))
+        any_failed=any_failed.or.restas_source_scan_failed(summary(pair,q))
+      enddo
+    enddo
+    flush(restas_velocity_stage_unit)
+    if(any_failed) error stop 'Candidate5 requested/applied boundary vector scan failed'
+  end subroutine restas_source_record_velocity_stage
+  !
+  subroutine restas_source_record_timestep_restriction(n,nh_d,nh_u,dt,time, &
+      state_index,consumed_state,dli,dzci,dzfi,u,v,w)
+    use mpi
+    use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+    use mod_param, only: rho1,rho2,mu1,mu2,sigma,small,cfl_c,cfl_d
+    use mod_types, only: MPI_REAL_RP
+    use mod_common_mpi, only: ierr
+    implicit none
+    integer, intent(in) :: n(3),nh_d,nh_u,state_index
+    logical, intent(in) :: consumed_state
+    real(rp), intent(in) :: dt,time,dli(3)
+    real(rp), intent(in) :: dzci(1-nh_d:),dzfi(1-nh_d:)
+    real(rp), intent(in) :: u(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: v(1-nh_u:,1-nh_u:,1-nh_u:)
+    real(rp), intent(in) :: w(1-nh_u:,1-nh_u:,1-nh_u:)
+    integer :: i,j,k
+    real(rp) :: ux,uy,uz,vx,vy,vz,wx,wy,wz
+    real(rp) :: dtix,dtiy,dtiz,dtic_raw,dtic_used,nu_max,dlmin,dlmini
+    real(rp) :: h_min
+    real(rp) :: dtiv,dtik,dtig,dtmax,dt_bound,dt_over,guard_limit,diagnostic_time
+    logical :: zero_fallback,capillary_active,guard_pass,all_finite,rate_nonfinite
+    character(len=16) :: guard_text
+    character(len=5) :: zero_fallback_text,capillary_text
+    if(.not.restas_source_loaded.or..not.restas_source_log_open) return
+    if(restas_heat_transfer_enabled) &
+      error stop 'Candidate5 timestep guard requires heat-transfer term implementation'
+    if(.not.restas_runtime_inputs_written.and.state_index.ne.0) &
+      error stop 'Candidate5 noninitial timestep requires captured frozen runtime inputs'
+    diagnostic_time=restas_time_start+real(state_index,rp)*restas_time_fixed_step
+    dtic_raw=0._rp
+    rate_nonfinite=.false.
+    all_finite=ieee_is_finite(dt).and.ieee_is_finite(time).and.ieee_is_finite(diagnostic_time)
+    do k=1,n(3)
+      do j=1,n(2)
+        do i=1,n(1)
+          ux=abs(u(i,j,k))
+          vx=0.25_rp*abs(v(i,j,k)+v(i,j-1,k)+v(i+1,j,k)+v(i+1,j-1,k))
+          wx=0.25_rp*abs(w(i,j,k)+w(i,j,k-1)+w(i+1,j,k)+w(i+1,j,k-1))
+          dtix=ux*dli(1)+vx*dli(2)+wx*dzfi(k)
+          uy=0.25_rp*abs(u(i,j,k)+u(i,j+1,k)+u(i-1,j+1,k)+u(i-1,j,k))
+          vy=abs(v(i,j,k))
+          wy=0.25_rp*abs(w(i,j,k)+w(i,j+1,k)+w(i,j+1,k-1)+w(i,j,k-1))
+          dtiy=uy*dli(1)+vy*dli(2)+wy*dzfi(k)
+          uz=0.25_rp*abs(u(i,j,k)+u(i-1,j,k)+u(i-1,j,k+1)+u(i,j,k+1))
+          vz=0.25_rp*abs(v(i,j,k)+v(i,j-1,k)+v(i,j-1,k+1)+v(i,j,k+1))
+          wz=abs(w(i,j,k))
+          dtiz=uz*dli(1)+vz*dli(2)+wz*dzci(k)
+          if(.not.ieee_is_finite(dtix).or..not.ieee_is_finite(dtiy).or. &
+             .not.ieee_is_finite(dtiz)) then
+            all_finite=.false.
+            if(.not.rate_nonfinite) then
+              if(.not.ieee_is_finite(dtix)) then
+                dtic_raw=dtix
+              elseif(.not.ieee_is_finite(dtiy)) then
+                dtic_raw=dtiy
+              else
+                dtic_raw=dtiz
+              endif
+              rate_nonfinite=.true.
+            endif
+          elseif(.not.rate_nonfinite) then
+            dtic_raw=max(dtic_raw,dtix,dtiy,dtiz)
+          endif
+        enddo
+      enddo
+    enddo
+    ! The source fixture is validated as one rank; keep a raw non-finite rate
+    ! out of MPI_MAX so the failure token cannot be hidden by reduction rules.
+    if(.not.rate_nonfinite) &
+      call mpi_allreduce(MPI_IN_PLACE,dtic_raw,1,MPI_REAL_RP,MPI_MAX,MPI_COMM_WORLD,ierr)
+    zero_fallback=(dtic_raw.eq.0._rp)
+    dtic_used=dtic_raw
+    if(zero_fallback) dtic_used=1._rp
+    zero_fallback_text='false'
+    if(zero_fallback) zero_fallback_text='true'
+    ! Match chkdt_tw operation order, including its full vertical dummy-array range.
+    dlmin=min(1._rp/dli(1),1._rp/dli(2),1._rp/dli(3))
+    dlmin=min(dlmin,minval(1._rp/dzfi(:)))
+    dlmini=dlmin**(-1)
+    h_min=dlmin
+    nu_max=max(mu1/rho1,mu2/rho2)
+    dtiv=nu_max*dlmini**2/cfl_d
+    capillary_active=(sigma.ne.0._rp)
+    capillary_text='false'
+    if(capillary_active) capillary_text='true'
+    dtik=small
+    if(capillary_active) dtik=sqrt(sigma/(min(rho1,rho2))*dlmini**3)
+    dtig=sqrt(max(abs(restas_gravity(1)),abs(restas_gravity(2)), &
+                  abs(restas_gravity(3)))*dlmini)
+    dt_bound=cfl_c*2._rp*(dtic_used+dtiv+sqrt((dtic_used+dtiv)**2+ &
+      4._rp*(dtig**2+dtik**2)))**(-1)
+    dtmax=min(dt_bound,1._rp/dtik)
+    if(.not.ieee_is_finite(dtic_raw).or..not.ieee_is_finite(dtic_used).or. &
+       .not.ieee_is_finite(nu_max).or..not.ieee_is_finite(h_min).or. &
+       .not.ieee_is_finite(dlmini).or..not.ieee_is_finite(dtiv).or..not.ieee_is_finite(dtik).or. &
+       .not.ieee_is_finite(dtig).or..not.ieee_is_finite(dtmax).or.dtmax.le.0._rp) &
+      all_finite=.false.
+    dt_over=dt/dtmax
+    guard_limit=restas_fixed_step_factor*dtmax
+    if(.not.ieee_is_finite(dt_over)) all_finite=.false.
+    if(.not.ieee_is_finite(guard_limit)) all_finite=.false.
+    guard_pass=all_finite.and.dt.gt.0._rp.and.dtmax.gt.0._rp.and. &
+      restas_fixed_step_factor.gt.0._rp.and.dt.le.guard_limit
+    if(guard_pass) then
+      guard_text='true'
+    else
+      guard_text='false'
+    endif
+    if(.not.consumed_state) guard_text='not_applicable'
+    ! Keep CSV columns in this order after nu_max: h_min,dlmini,dtiv,dtik,dtig.
+    write(restas_timestep_unit, &
+      '(I0,4(",",A),",",A,6(",",A),",",A,3(",",A),",",A)') &
+      state_index,trim(restas_source_real_text(diagnostic_time)), &
+      trim(restas_source_real_text(dt)),trim(restas_source_real_text(dtic_raw)), &
+      trim(restas_source_real_text(dtic_used)),trim(zero_fallback_text), &
+      trim(restas_source_real_text(nu_max)),trim(restas_source_real_text(h_min)), &
+      trim(restas_source_real_text(dlmini)),trim(restas_source_real_text(dtiv)), &
+      trim(restas_source_real_text(dtik)),trim(restas_source_real_text(dtig)), &
+      trim(capillary_text),trim(restas_source_real_text(dtmax)), &
+      trim(restas_source_real_text(restas_fixed_step_factor)), &
+      trim(restas_source_real_text(dt_over)),trim(guard_text)
+    flush(restas_timestep_unit)
+    if(.not.all_finite) &
+      error stop 'Candidate5 full AB2 restriction contains a non-finite state'
+    if(consumed_state.and..not.guard_pass) &
+      error stop 'Candidate5 fixed-step AB2 restriction failed'
+  end subroutine restas_source_record_timestep_restriction
+  !
+  subroutine restas_source_close_log()
+    implicit none
+    if(restas_source_log_open) then
+      close(restas_source_flux_unit)
+      close(restas_offmask_unit)
+      close(restas_rate_unit)
+      close(restas_boundary_unit)
+      close(restas_mass_unit)
+      close(restas_velocity_unit)
+      close(restas_phase_stage_unit)
+      close(restas_velocity_stage_unit)
+      close(restas_timestep_unit)
