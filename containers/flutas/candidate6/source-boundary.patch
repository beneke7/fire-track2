+      'scanned_cells,mismatch_count,nonfinite_count,max_abs_error,first_bad_i,'// &
+      'first_bad_j,first_bad_k,expected,observed'
+    write(restas_velocity_stage_unit,'(A)') &
+      'state_index,transport_interval_index,stage_id,face,source_class,component,'// &
+      'scanned_cells,mismatch_count,nonfinite_count,max_abs_error,first_bad_i,'// &
+      'first_bad_j,first_bad_k,requested,applied'
+    write(restas_timestep_unit,'(A)') &
+      'state_index,time_s,dt_s,dtic_raw_s_inv,dtic_used_s_inv,zero_advection_fallback,'// &
+      'nu_max_m2_s,h_min_m,dlmini_m_inv,dtiv_s_inv,dtik_s_inv,dtig_s_inv,capillary_active,'// &
+      'dtmax_s,fixed_step_factor,dt_over_dtmax,guard_pass'
