+    if(ierr.ne.0) error stop 'Cannot create candidate5 ledger without overwrite'
+    open(newunit=restas_boundary_unit,file=trim(path_prefix)//'_boundary-ledger.csv',status='new',action='write',iostat=ierr)
+    if(ierr.ne.0) error stop 'Cannot create candidate5 ledger without overwrite'
+    open(newunit=restas_mass_unit,file=trim(path_prefix)//'_mass-ledger.csv',status='new',action='write',iostat=ierr)
+    if(ierr.ne.0) error stop 'Cannot create candidate5 ledger without overwrite'
+    open(newunit=restas_velocity_unit,file=trim(path_prefix)//'_velocity-audit.csv',status='new',action='write',iostat=ierr)
+    if(ierr.ne.0) error stop 'Cannot create candidate5 ledger without overwrite'
+    write(restas_source_flux_unit,'(A)') &
+      'interval_index,slot,requested_volume_m3,geometric_inward_volume_m3,requested_mass_kg,'// &
+      'applied_inward_mass_kg,requested_mom_x_kgm_s,requested_mom_y_kgm_s,'// &
+      'requested_mom_z_kgm_s,applied_mom_x_kgm_s,applied_mom_y_kgm_s,'// &
+      'applied_mom_z_kgm_s,slot_reverse_out_m3'
+    write(restas_offmask_unit,'(A)') 'interval_index,offmask_in_m3,offmask_out_m3'
+    write(restas_rate_unit,'(A)') &
+      'interval_index,measured_top_liquid_m3_s,expected_top_liquid_m3_s,top_residual_m3_s,'// &
+      'measured_bottom_volume_m3_s,expected_bottom_volume_m3_s,bottom_residual_m3_s'
+    write(restas_boundary_unit,'(A)') &
+      'completed_state_index,xlow_in_m3,xlow_out_m3,xhigh_in_m3,xhigh_out_m3,'// &
+      'ylow_in_m3,ylow_out_m3,yhigh_in_m3,yhigh_out_m3,'// &
+      'zlow_in_m3,zlow_out_m3,zhigh_in_m3,zhigh_out_m3'
+    write(restas_mass_unit,'(A)') &
+      'state_index,time_s,box_liquid_kg,initial_liquid_kg,cumulative_boundary_in_kg,'// &
+      'cumulative_boundary_out_kg,residual_kg,net_boundary_liquid_m3,'// &
+      'xlow_in_kg,xlow_out_kg,xhigh_in_kg,xhigh_out_kg,'// &
+      'ylow_in_kg,ylow_out_kg,yhigh_in_kg,yhigh_out_kg,'// &
+      'zlow_in_kg,zlow_out_kg,zhigh_in_kg,zhigh_out_kg'
+    write(restas_velocity_unit,'(A)') &
+      'state_index,source_profile_interval,time_s,dt_s,total_cell_count,'// &
+      'global_chkdt_advective_courant_max,interface_cell_count,interface_courant_defined,'// &
+      'interface_advective_courant_max,top_in_m3_s,bottom_out_m3_s,net_boundary_m3_s,'// &
+      'integrated_divergence_m3_s,closure_m3_s,max_abs_divergence_s,'// &
+      'volume_integrated_abs_divergence_m3_s,xlow_out_m3_s,xhigh_out_m3_s,'// &
+      'ylow_out_m3_s,yhigh_out_m3_s,zlow_out_m3_s,zhigh_out_m3_s'
+    open(newunit=restas_phase_stage_unit,file=trim(path_prefix)// &
+      '_phase-property-stage-audit.csv',status='new',action='write',iostat=ierr)
+    if(ierr.ne.0) error stop 'Cannot create candidate5 phase audit without overwrite'
+    open(newunit=restas_velocity_stage_unit,file=trim(path_prefix)// &
+      '_boundary-velocity-stage-audit.csv',status='new',action='write',iostat=ierr)
+    if(ierr.ne.0) error stop 'Cannot create candidate5 velocity audit without overwrite'
+    open(newunit=restas_timestep_unit,file=trim(path_prefix)// &
+      '_timestep-restriction.csv',status='new',action='write',iostat=ierr)
+    if(ierr.ne.0) error stop 'Cannot create candidate5 timestep audit without overwrite'
+    write(restas_phase_stage_unit,'(A)') &
