ARG BASE_IMAGE=track2/flutas-nvhpc:26.9
FROM ${BASE_IMAGE}

ARG FLUTAS_COMMIT=598210616bebd51f7d51f61455f196e6f3479916

COPY source-boundary.patch /tmp/candidate6-source-boundary.patch

RUN set -eux; \
    test "$(git -C /opt/FluTAS rev-parse HEAD)" = "${FLUTAS_COMMIT}"; \
    test "$(sha256sum /opt/FluTAS/src/targets/target.generic-gpu | cut -d ' ' -f 1)" = \
      d694b6db322a2f9391ef09bb697bade0cb32ec3ab3f11bd6dfe9dba814a43759; \
    git -C /opt/FluTAS apply --check /tmp/candidate6-source-boundary.patch; \
    git -C /opt/FluTAS apply /tmp/candidate6-source-boundary.patch; \
    make -C /opt/FluTAS/src clean; \
    make -C /opt/FluTAS/src -j2 ARCH=generic-gpu APP=two_phase_inc_isot; \
    cuobjdump --list-elf /opt/FluTAS/src/flutas.two_phase_inc_isot \
      | tee /opt/FluTAS/candidate6-cuobjdump.txt \
      | grep -F 'sm_120.cubin'; \
    test -x /opt/FluTAS/src/flutas.two_phase_inc_isot; \
    sha256sum /opt/FluTAS/src/flutas.two_phase_inc_isot \
      > /opt/FluTAS/candidate6-executable.sha256

# This image retains the compiled candidate for inspection. Its default
# command is inert; the Dockerfile never launches a CFD case or requests a GPU.
ENTRYPOINT ["/bin/true"]
