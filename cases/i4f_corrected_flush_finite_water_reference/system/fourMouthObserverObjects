fourMouthPlaneAreaAlpha
{
    type surfaceFieldValue;
    libs (fieldFunctionObjects);
    regionType sampledSurface;
    name fourMouthPlane;
    sampledSurfaceDict
    {
        type plane;
        point (4.79 0 0.775);
        normal (1 0 0);
        triangulate true;
    }
    operation areaAverage;
    fields (alpha.water U p T);
    writeControl runTime;
    writeInterval 0.001;
    writeFields true;
    surfaceFormat vtk;
    log true;
    writeArea true;
}
