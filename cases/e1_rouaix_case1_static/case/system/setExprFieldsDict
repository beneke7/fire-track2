FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}

expressions
(
    hydrostaticAirPressure
    {
        field p_rgh;
        dimensions [1 -1 -2 0 0 0 0];
        expression #{ 1.18*9.81*pos().y() #};
    }
);
