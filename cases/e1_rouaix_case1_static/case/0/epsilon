    }

    aircraftWall
    {
        type            epsilonWallFunction;
        value           uniform 0;
    }

    downstreamOutlet
    {
        type            inletOutlet;
        inletValue      uniform 3.6978974178;
        value           uniform 0;
    }

    bottomOutlet
    {
        type            inletOutlet;
        inletValue      uniform 3.6978974178;
        value           uniform 0;
    }

    spanwiseMinus
    {
        type            inletOutlet;
        inletValue      uniform 3.6978974178;
        value           uniform 0;
    }

    spanwisePlus
    {
        type            inletOutlet;
        inletValue      uniform 3.6978974178;
        value           uniform 0;
    }
