FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    nozzle
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    gasInlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    aircraftWall
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    downstreamOutlet
    {
        type            prghPressure;
        p               uniform 0;
        rho             rho;
        value           uniform 0;
    }

    bottomOutlet
    {
        type            prghPressure;
        p               uniform 0;
        rho             rho;
        value           uniform 0;
    }

    spanwiseMinus
    {
        type            prghPressure;
        p               uniform 0;
        rho             rho;
        value           uniform 0;
    }

    spanwisePlus
    {
        type            prghPressure;
        p               uniform 0;
        rho             rho;
        value           uniform 0;
    }
}
