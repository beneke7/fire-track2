FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object controlDict;
}
application compressibleInterFoam;
i4fFrozenPredictorSp true;
startFrom latestTime;
startTime 4.368e-05;
stopAt endTime;
endTime 0.005;
deltaT 0.00001;
writeControl runTime;
writeInterval 0.005;
purgeWrite 0;
writeFormat binary;
writePrecision 8;
writeCompression off;
fileHandler collated;
timeFormat general;
timePrecision 12;
runTimeModifiable yes;
adjustTimeStep yes;
maxCo 0.5;
maxAlphaCo 0.25;
maxDeltaT 0.00025;
functions
{
    #include "twoTankLedgerObjects"
    #include "fourMouthObserverObjects"
    #include "i4fNumericalHealthObjects"
    #include "finalStepCheckpoint"
}
