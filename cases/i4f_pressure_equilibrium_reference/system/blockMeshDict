FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
convertToMeters 1;
vertices
(
    (0 0 0) (1 0 0) (1 0.08 0) (0 0.08 0)
    (0 0 0.08) (1 0 0.08) (1 0.08 0.08) (0 0.08 0.08)
);
blocks ( hex (0 1 2 3 4 5 6 7) (100 8 8) simpleGrading (1 1 1) );
edges ();
boundary
(
    xMin { type cyclic; neighbourPatch xMax; transform translational; separationVector (1 0 0); matchTolerance 1e-7; faces ((0 4 7 3)); }
    xMax { type cyclic; neighbourPatch xMin; transform translational; separationVector (-1 0 0); matchTolerance 1e-7; faces ((1 2 6 5)); }
    yMin { type cyclic; neighbourPatch yMax; transform translational; separationVector (0 0.08 0); matchTolerance 1e-7; faces ((0 1 5 4)); }
    yMax { type cyclic; neighbourPatch yMin; transform translational; separationVector (0 -0.08 0); matchTolerance 1e-7; faces ((3 7 6 2)); }
    zMin { type cyclic; neighbourPatch zMax; transform translational; separationVector (0 0 0.08); matchTolerance 1e-7; faces ((0 3 2 1)); }
    zMax { type cyclic; neighbourPatch zMin; transform translational; separationVector (0 0 -0.08); matchTolerance 1e-7; faces ((4 5 6 7)); }
);
mergePatchPairs ();
