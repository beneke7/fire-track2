    }
    alphaExtrema
    {
        type fieldMinMax;
        libs (fieldFunctionObjects);
        fields (alpha.water);
        location false;
        log true;
        writePrecision 12;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    speedExtrema
    {
        type fieldMinMax;
        libs (fieldFunctionObjects);
        mode magnitude;
        fields (U);
