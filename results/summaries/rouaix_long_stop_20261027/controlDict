    }
    failureLocations
    {
        type fieldMinMax;
        libs (fieldFunctionObjects);
        mode magnitude;
        fields (U p_rgh k epsilon nut);
        location true;
        log true;
        writePrecision 12;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
}
