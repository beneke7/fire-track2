FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application interIsoFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 5;
deltaT 0.0001;
adjustTimeStep no;
maxCo 5;
maxAlphaCo 5;
maxDeltaT 0.0001;
writeControl runTime;
writeInterval 1;
purgeWrite 2;
writeFormat binary;
writePrecision 12;
writeCompression off;
timeFormat fixed;
timePrecision 12;
runTimeModifiable false;
OptimisationSwitches
{
    fileHandler collated;
    maxThreadFileBufferSize 0;
    writeNowSignal 10;
    stopAtWriteNowSignal 12;
}
functions
{
    waterVolume
    {
        type volFieldValue;
        libs (fieldFunctionObjects);
        fields (alpha.water);
        operation volIntegrate;
        regionType all;
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    nozzleFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name nozzle;
        operation sum;
        fields (phi alphaPhi_);
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    gasInletFlux
    {
        type surfaceFieldValue;
