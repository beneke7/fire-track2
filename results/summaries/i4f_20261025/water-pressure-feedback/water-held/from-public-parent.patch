+    using Value = std::decay_t<decltype(values[0])>;
+    const unsigned char* bytes =
+        reinterpret_cast<const unsigned char*>(values.begin());
+    const std::size_t byteCount = values.size()*sizeof(Value);
+    std::uint64_t hash = 14695981039346656037ull;
+    for (std::size_t bytei = 0; bytei < byteCount; ++bytei)
+    {
+        hash ^= bytes[bytei];
+        hash *= 1099511628211ull;
+    }
+    return hash;
+};
