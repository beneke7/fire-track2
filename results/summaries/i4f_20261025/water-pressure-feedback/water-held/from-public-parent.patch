+auto i4fProbeHashGeometric =
+[&]
+(const auto& field)
+{
+    std::uint64_t hash = i4fProbeHashValues(field.primitiveField());
+    forAll(field.boundaryField(), patchi)
+    {
+        hash ^= i4fProbeHashValues(field.boundaryField()[patchi]);
+        hash *= 1099511628211ull;
+    }
+    return hash;
+};
