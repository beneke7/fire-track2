+// One-shot diagnostic, included after the original final outer/second pressure
+// solve and before the stock pressure floor, EOS update, phi/U update, or write.
+// It changes only p_rgh while applying the frozen pressure map.
+
+if (!pimple.transonic())
+{
+    FatalErrorInFunction
+        << "The frozen pressure probe requires the declared transonic branch"
+        << exit(FatalError);
+}
+
+const label i4fProbeRank = Pstream::myProcNo();
+const label i4fProbeCellA = 1779;   // global cell 31926 on partition 7
+const label i4fProbeCellB = 3759;   // global cell 62270 on partition 7
+const label i4fProbeFace = 8995;    // global face 136938; raw faceProcAddressing=136939
+
+std::ostringstream i4fProbeRankName;
+i4fProbeRankName << "rank" << i4fProbeRank;
+const std::string i4fProbeStem
+(
+    "i4f_frozen_pressure_probe/" + i4fProbeRankName.str()
+);
+std::ofstream i4fProbeState
+(
+    i4fProbeStem + ".state.bin",
+    std::ios::out | std::ios::binary | std::ios::trunc
+);
+std::ofstream i4fProbeStateIndex(i4fProbeStem + ".state-index.csv");
+std::ofstream i4fProbeSweeps
+(
+    i4fProbeStem + ".sweeps.bin",
+    std::ios::out | std::ios::binary | std::ios::trunc
+);
+std::ofstream i4fProbeSweepIndex(i4fProbeStem + ".sweeps-index.csv");
+if
+(
+    !i4fProbeState.good()
+ || !i4fProbeStateIndex.good()
+ || !i4fProbeSweeps.good()
+ || !i4fProbeSweepIndex.good()
+)
+{
+    FatalErrorInFunction
+        << "Unable to create frozen-pressure diagnostic outputs under "
+        << i4fProbeStem << exit(FatalError);
+}
+
+i4fProbeStateIndex
+    << "name,section,count,byte_offset,value_bytes,encoding\n";
+i4fProbeSweepIndex
+    << "name,section,count,byte_offset,value_bytes,encoding\n";
+
+auto i4fProbeWriteValues =
+[&]
+(const std::string& name, const std::string& section, const auto& values)
+{
+    using Value = std::decay_t<decltype(values[0])>;
+    const std::streamoff offset = i4fProbeState.tellp();
+    const std::streamsize bytes =
+        static_cast<std::streamsize>(values.size()*sizeof(Value));
+    if (bytes)
+    {
+        i4fProbeState.write
+        (
+            reinterpret_cast<const char*>(values.begin()),
+            bytes
+        );
+    }
+    i4fProbeStateIndex
+        << name << ',' << section << ',' << values.size() << ','
+        << offset << ',' << sizeof(Value) << ",host-native-raw\n";
+};
+
+auto i4fProbeWriteSweepValues =
+[&]
+(const std::string& name, const std::string& section, const auto& values)
+{
+    using Value = std::decay_t<decltype(values[0])>;
+    const std::streamoff offset = i4fProbeSweeps.tellp();
+    const std::streamsize bytes =
+        static_cast<std::streamsize>(values.size()*sizeof(Value));
+    if (bytes)
+    {
+        i4fProbeSweeps.write
+        (
+            reinterpret_cast<const char*>(values.begin()),
+            bytes
+        );
+    }
+    i4fProbeSweepIndex
+        << name << ',' << section << ',' << values.size() << ','
+        << offset << ',' << sizeof(Value) << ",host-native-raw\n";
+};
+
+auto i4fProbeWriteGeometric =
+[&]
+(const std::string& name, const auto& field)
+{
+    i4fProbeWriteValues(name, "internal", field.primitiveField());
+    forAll(field.boundaryField(), patchi)
+    {
+        const std::string patchSection
+        (
+            "patch_" + std::to_string(patchi)
+        );
+        i4fProbeWriteValues
+        (
+            name,
+            patchSection,
+            field.boundaryField()[patchi]
+        );
+    }
+};
+
+auto i4fProbeWriteMatrix =
+[&]
+(const std::string& name, const fvScalarMatrix& matrix)
+{
+    i4fProbeWriteValues(name + "_diag", "internal", matrix.diag());
+    i4fProbeWriteValues(name + "_upper", "internal_faces", matrix.upper());
+    i4fProbeWriteValues(name + "_lower", "internal_faces", matrix.lower());
+    i4fProbeWriteValues(name + "_source", "internal", matrix.source());
+    forAll(matrix.internalCoeffs(), patchi)
+    {
+        i4fProbeWriteValues
+        (
+            name + "_internalCoeffs",
+            "patch_" + std::to_string(patchi),
+            matrix.internalCoeffs()[patchi]
+        );
+        i4fProbeWriteValues
+        (
+            name + "_boundaryCoeffs",
+            "patch_" + std::to_string(patchi),
+            matrix.boundaryCoeffs()[patchi]
+        );
+    }
+};
+
+auto i4fProbeHashValues =
