FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system";
    object controlDict;
}
application compressibleInterFoam;
i4fFrozenPredictorSp true;
i4fFrozenPredictorFullSource true;
i4fFullPressureAudit false;
i4fPressureCycleObserver false;
startFrom latestTime;
startTime 0.390705595007;
stopAt endTime;
endTime 0.650000000000;
deltaT 0.00001;
writeControl runTime;
writeInterval 0.1;
purgeWrite 0;
writeFormat binary;
writePrecision 8;
writeCompression off;
fileHandler collated;
timeFormat general;
timePrecision 12;
runTimeModifiable yes;
adjustTimeStep yes;
maxCo 0.5;
maxAlphaCo 0.25;
maxDeltaT 0.00025;
functions
{
    #include "twoTankLedgerObjects"
    #include "fourMouthObserverObjects"
    #include "valveBandFluxObjects"
    #include "i4fNumericalHealthObjects"
    #include "finalStepCheckpoint"
}
