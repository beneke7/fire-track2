+    scalar sourceSu = 0;
+    if (gamma > 0)
+    {
+        sourceSp -= gamma/Foam::max(1.0 - sourceAlpha, scalar(1e-4));
+        sourceSu += gamma/Foam::max(1.0 - sourceAlpha, scalar(1e-4));
+    }
