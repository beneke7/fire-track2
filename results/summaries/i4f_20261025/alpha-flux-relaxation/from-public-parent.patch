+        label commonHashMismatch =
+            i4fAlphaFluxRelaxHashField("T_common", T)
+         != i4fAlphaFluxRelaxCommonTHashAtTrigger;
+        reduce(commonHashMismatch, sumOp<label>());
+        i4fAlphaFluxRelaxCommonTHashMismatchCount += commonHashMismatch;
+
+        if (sweep == 1 || waterOutside || airOutside || commonHashMismatch)
+        {
+            const std::string stage =
+                sweep == 1
+              ? "sweep1_after_refresh"
+              : "sweep" + std::to_string(sweep) + "_violation_after_refresh";
+            i4fAlphaFluxRelaxWritePhaseSnapshot(stage, "T_common", T);
+            i4fAlphaFluxRelaxWritePhaseSnapshot
+            (
+                stage, "T_water_thermo1", mixture.thermo1().T()
+            );
+            i4fAlphaFluxRelaxWritePhaseSnapshot
+            (
+                stage, "T_air_thermo2", mixture.thermo2().T()
+            );
+        }
+        if (commonHashMismatch)
+        {
+            FatalErrorInFunction
+                << "Shared common T changed during frozen alpha flux relaxation map"
+                << exit(FatalError);
+        }
+        if (waterOutside || airOutside)
+        {
+            FatalErrorInFunction
+                << "Phase-T rederivation exceeded the predeclared 128-epsilon bound; "
+                   "trigger and current phase arrays were saved before abort"
+                << " water_outside=" << waterOutside
+                << " air_outside=" << airOutside
+                << exit(FatalError);
+        }
+    };
+
+    auto i4fAlphaFluxRelaxCaptureHeld =
+    [&](const label sweep, const bool captureBaseline)
+    {
+        std::vector<std::pair<std::string, std::uint64_t>> current;
+        auto capture =
+        [&](const std::string& name, const auto& field)
+        {
+            const std::uint64_t value = i4fAlphaFluxRelaxHashField(name, field);
+            current.emplace_back(name, value);
+        };
+        capture("T_common", T);
+        capture("T_water_thermo1", mixture.thermo1().T());
+        capture("T_air_thermo2", mixture.thermo2().T());
+        capture("nut", mesh.lookupObject<volScalarField>("nut"));
+        capture("alphat", mesh.lookupObject<volScalarField>("alphat"));
+        if (i4fHasKTransport)
+        {
+            capture("k", mesh.lookupObject<volScalarField>("k"));
+        }
+        if (i4fHasOmegaTransport)
+        {
+            capture("omega", mesh.lookupObject<volScalarField>("omega"));
+        }
+        capture("alpha1_oldTime", alpha1.oldTime());
+        capture("alpha2_oldTime", alpha2.oldTime());
+        capture("rho_oldTime", rho.oldTime());
+        capture("rho1_oldTime", rho1.oldTime());
+        capture("rho2_oldTime", rho2.oldTime());
+        capture("U_oldTime", U.oldTime());
+        capture("T_oldTime", T.oldTime());
+        capture("K_oldTime", K.oldTime());
+        capture("p_rgh_oldTime", p_rgh.oldTime());
+        capture("phi_oldTime", phi.oldTime());
+        if (i4fHasKTransport)
+        {
+            capture("k_oldTime", mesh.lookupObject<volScalarField>("k").oldTime());
+        }
+        if (i4fHasOmegaTransport)
+        {
+            capture("omega_oldTime", mesh.lookupObject<volScalarField>("omega").oldTime());
+        }
+
+        label mismatchLocal = 0;
+        if (captureBaseline)
+        {
+            i4fAlphaFluxRelaxHeldHashes = current;
+        }
+        else
+        {
+            if (current.size() != i4fAlphaFluxRelaxHeldHashes.size())
+            {
+                ++mismatchLocal;
+            }
+            else
+            {
+                for (std::size_t i = 0; i < current.size(); ++i)
+                {
+                    const bool phaseTRederivation
+                    (
+                        current[i].first == i4fAlphaFluxRelaxHeldHashes[i].first
+                     &&
+                        (
+                            current[i].first == "T_water_thermo1"
+                         || current[i].first == "T_air_thermo2"
+                        )
+                    );
+                    if
+                    (
+                        current[i].first != i4fAlphaFluxRelaxHeldHashes[i].first
+                     ||
+                        (
+                            !phaseTRederivation
+                         && current[i].second != i4fAlphaFluxRelaxHeldHashes[i].second
+                        )
+                    )
+                    {
+                        ++mismatchLocal;
+                    }
+                }
+            }
+        }
+        label mismatchGlobal = mismatchLocal;
+        reduce(mismatchGlobal, sumOp<label>());
+        for (const auto& row : current)
+        {
+            Pout<< "I4F_ALPHA_FLUX_RELAX_HELD_HASH"
+                << " sweep=" << sweep
+                << " baseline=" << captureBaseline
+                << " rank=" << Pstream::myProcNo()
+                << " field=" << row.first
+                << " fnv1a64=" << row.second
+                << nl;
+        }
+        Info<< "I4F_ALPHA_FLUX_RELAX_HELD_INTEGRITY"
+            << " sweep=" << sweep
+            << " held_field_count=" << current.size()
+            << " rank_local_mismatches=" << mismatchLocal
+            << " all_rank_mismatches=" << mismatchGlobal
+            << " phase_T_hash_differences_checked_numerically=true"
+            << nl << endl;
+        if (mismatchGlobal)
+        {
+            FatalErrorInFunction
+                << "A field declared frozen changed during the alpha flux relaxation map"
+                << exit(FatalError);
+        }
+    };
+
+    // Every measured sweep is deliberately kept at the original final outer
+    // iteration state: pimple.corr()==8 and finalIter()==true throughout.
+    // Only the PISO/corrector counter is reset by its normal two-pass loop.
+    i4fAlphaFluxRelaxMapActive = true;
+    Info<< "I4F_ALPHA_FLUX_RELAX_MAP_BEGIN"
+        << " time_s=" << i4fAlphaFluxRelaxTriggerTime
+        << " time_index=" << i4fAlphaFluxRelaxTriggerTimeIndex
+        << " deltaT_s=" << i4fAlphaFluxRelaxTriggerDeltaT
+        << " physical_outer_iteration=" << i4fPimpleOuterIteration
+        << " physical_pressure_correctors=" << i4fPressureCorrectorIndex
+        << " diagnostic_sweeps=16"
+        << " alpha_flux_relaxation_omega=" << i4fAlphaFluxRelaxOmega
+        << " relaxation_applies_only_after_stock_MULES=true"
+        << " omega_1_branch_bypasses_all_relaxation_assignments=true"
+        << " alpha_water_evolving=true"
+        << " alphaPhi1_water_evolving=true"
+        << " alpha_oldTime_held=true"
+        << " alphaPhi1_oldTime_levels_at_trigger="
+        << i4fAlphaFluxRelaxAlphaPhiOldTimeLevelsAtTrigger
+        << " stock_alphaControls_per_sweep=true"
+        << " nAlphaSubCycles=1"
+        << " LTS=false"
+        << " common_T_held_exact=true"
+        << " phase_T_rederived_numeric_bound=true"
+        << " phase_T_bound_scaled_epsilon_units="
+        << i4fAlphaFluxRelaxPhaseTBoundEpsilonUnits
+        << " turbulence_correct_disabled=true"
+        << " no_time_advance=true"
+        << " no_physical_checkpoint=true"
+        << " pimple_finalIter_held_true=true"
+        << " finalSolver_selection_matches_original_outer8=true"
+        << nl << endl;
+    i4fAlphaFluxRelaxWriteRawStateSnapshot("trigger", "p", p);
+    i4fAlphaFluxRelaxWriteRawStateSnapshot("trigger", "U", U);
+    i4fAlphaFluxRelaxWriteRawStateSnapshot("trigger", "alpha1", alpha1);
+    i4fAlphaFluxRelaxWriteRawStateSnapshot("trigger", "alphaPhi10", alphaPhi10);
+    Pout<< "I4F_ALPHA_FLUX_RELAX_TRIGGER_HASH field=p fnv1a64="
+        << i4fAlphaFluxRelaxHashField("p", p) << nl;
+    Pout<< "I4F_ALPHA_FLUX_RELAX_TRIGGER_HASH field=U fnv1a64="
+        << i4fAlphaFluxRelaxHashField("U", U) << nl;
+    Pout<< "I4F_ALPHA_FLUX_RELAX_TRIGGER_HASH field=alpha1 fnv1a64="
+        << i4fAlphaFluxRelaxHashField("alpha1", alpha1) << nl;
+    Pout<< "I4F_ALPHA_FLUX_RELAX_TRIGGER_HASH field=alphaPhi10 fnv1a64="
+        << i4fAlphaFluxRelaxHashField("alphaPhi10", alphaPhi10) << nl;
+    i4fAlphaFluxRelaxWritePhaseSnapshot("trigger", "T_common", T);
+    i4fAlphaFluxRelaxWritePhaseSnapshot
+    (
+        "trigger", "T_water_thermo1", mixture.thermo1().T()
+    );
+    i4fAlphaFluxRelaxWritePhaseSnapshot
+    (
+        "trigger", "T_air_thermo2", mixture.thermo2().T()
+    );
+    i4fAlphaFluxRelaxRecordPhaseTDelta(0);
+    i4fAlphaFluxRelaxCaptureHeld(0, true);
+
+    bool i4fAlphaFluxRelaxHavePreviousDp = false;
+    scalarField i4fAlphaFluxRelaxPreviousDp(mesh.nCells(), Zero);
+    label i4fAlphaFluxRelaxIdentityChecks = 0;
+
+    for (label i4fAlphaFluxRelaxSweep = 1; i4fAlphaFluxRelaxSweep <= 16; ++i4fAlphaFluxRelaxSweep)
+    {
+        i4fAlphaFluxRelaxMapSweep = i4fAlphaFluxRelaxSweep;
+        if
+        (
+            !pimple.finalIter()
+         || pimple.corr() != 8
+         || pimple.corrPISO() != 0
+         || runTime.timeIndex() != i4fAlphaFluxRelaxTriggerTimeIndex
+         || runTime.value() != i4fAlphaFluxRelaxTriggerTime
+         || runTime.deltaTValue() != i4fAlphaFluxRelaxTriggerDeltaT
+        )
+        {
+            FatalErrorInFunction
+                << "PIMPLE final-iteration or Time state changed during diagnostic sweep "
+                << i4fAlphaFluxRelaxSweep << exit(FatalError);
+        }
+
+        const scalarField pBeforeSweep(p.primitiveField());
+        const vectorField UBeforeSweep(U.primitiveField());
+        const scalarField rho1BeforeSweep(rho1.primitiveField());
+        const scalarField rho2BeforeSweep(rho2.primitiveField());
+        const scalarField dgdtBeforeSweep(dgdt.primitiveField());
+        const scalarField alpha1BeforeSweep(alpha1.primitiveField());
+        const scalarField alpha2BeforeSweep(alpha2.primitiveField());
+        const scalarField TBeforeSweep(T.primitiveField());
+        i4fAlphaFluxRelaxEntryAlpha = alpha1;
+        i4fAlphaFluxRelaxEntryFlux = alphaPhi10;
+        surfaceScalarField alphaPhi1BeforeSweep
+        (
+            IOobject
+            (
+                "i4fAlphaPhi1BeforeSweep",
+                runTime.timeName(),
+                mesh,
+                IOobject::NO_READ,
+                IOobject::NO_WRITE,
+                false
+            ),
+            alphaPhi10
+        );
+        surfaceScalarField phiBeforeSweep
+        (
+            IOobject
+            (
+                "i4fPhiBeforeWaterSweep",
+                runTime.timeName(),
+                mesh,
+                IOobject::NO_READ,
+                IOobject::NO_WRITE,
+                false
+            ),
+            phi
+        );
+        surfaceScalarField rhoPhiBeforeSweep
+        (
+            IOobject
+            (
+                "i4fRhoPhiBeforeWaterSweep",
+                runTime.timeName(),
+                mesh,
+                IOobject::NO_READ,
+                IOobject::NO_WRITE,
+                false
+            ),
+            rhoPhi
+        );
+        const label alphaPhiOldTimeLevelsBeforeSweep = alphaPhi10.nOldTimes();
+        if
+        (
+            alphaPhiOldTimeLevelsBeforeSweep
+         != i4fAlphaFluxRelaxAlphaPhiOldTimeLevelsAtTrigger
+         || alpha1.nOldTimes() != i4fAlphaFluxRelaxAlphaOldTimeLevelsAtTrigger
+        )
+        {
+            FatalErrorInFunction
+                << "alphaPhi1 old-time level count changed before map sweep "
+                << i4fAlphaFluxRelaxSweep << exit(FatalError);
+        }
+        scalar waterInventoryBeforeLocal = 0;
+        scalar gasInventoryBeforeLocal = 0;
+        forAll(alpha1, celli)
+        {
+            waterInventoryBeforeLocal += alpha1[celli]*rho1[celli]*mesh.V()[celli];
+            gasInventoryBeforeLocal += alpha2[celli]*rho2[celli]*mesh.V()[celli];
+        }
+        reduce(waterInventoryBeforeLocal, sumOp<scalar>());
+        reduce(gasInventoryBeforeLocal, sumOp<scalar>());
+
+        i4fAlphaFluxRelaxGammaAtEntry = dgdt.primitiveField();
+        i4fAlphaFluxRelaxSourceCaptureCalls = 0;
+        i4fAlphaFluxRelaxCaptureSource = true;
+
+        // Reuse the stock alpha controls and alpha/MULES source directly.
+        // A subcycle would advance Time; this frozen map requires one Euler
+        // alpha pass at the unchanged trigger time.
+        #include "alphaControls.H"
+        if (nAlphaSubCycles != 1 || LTS || !MULESCorr || nAlphaCorr != 1)
+        {
+            FatalErrorInFunction
+                << "Alpha-flux-relaxation map requires nAlphaSubCycles=1, "
+                   "LTS=false, MULESCorr=true, nAlphaCorr=1; got "
+                << nAlphaSubCycles << ", " << LTS << ", " << MULESCorr
+                << ", " << nAlphaCorr << exit(FatalError);
+        }
+        #include "compressibleAlphaEqnSubCycle.H"
+        if
+        (
+            i4fAlphaFluxRelaxCaptureSource
+         || i4fAlphaFluxRelaxSourceCaptureCalls != 2
+        )
+        {
+            FatalErrorInFunction
+                << "Stock MULES predictor/corrector source calls did not close "
+                   "exactly twice at sweep "
+                << i4fAlphaFluxRelaxSweep << exit(FatalError);
+        }
+        ++i4fAlphaFluxRelaxIdentityChecks;
+        if
+        (
+            runTime.timeIndex() != i4fAlphaFluxRelaxTriggerTimeIndex
+         || runTime.value() != i4fAlphaFluxRelaxTriggerTime
+         || runTime.deltaTValue() != i4fAlphaFluxRelaxTriggerDeltaT
+        )
+        {
+            FatalErrorInFunction
+                << "Stock alpha include advanced Time during map sweep "
+                << i4fAlphaFluxRelaxSweep << exit(FatalError);
+        }
+        if
+        (
+            alphaPhi10.nOldTimes()
+         != i4fAlphaFluxRelaxAlphaPhiOldTimeLevelsAtTrigger
+         || alpha1.nOldTimes() != i4fAlphaFluxRelaxAlphaOldTimeLevelsAtTrigger
+        )
+        {
+            FatalErrorInFunction
+                << "alphaPhi1 old-time level count changed during alpha include at sweep "
+                << i4fAlphaFluxRelaxSweep << exit(FatalError);
+        }
+
+        // Match the stock source order: alpha/flux, phase flux, UEqn, then the
+        // post-TEqn thermo refresh at unchanged T before pressure correctors.
+        turbulence.correctPhasePhi();
+        fvVectorMatrix UEqn
+        (
+            fvm::ddt(rho, U) + fvm::div(rhoPhi, U)
+          - fvm::Sp(contErr, U)
+          + MRF.DDt(rho, U)
+          + turbulence.divDevRhoReff(U)
+         ==
+            fvOptions(rho, U)
+        );
+        UEqn.relax();
+        fvOptions.constrain(UEqn);
+
+        const scalarField pBeforeThermoRefresh(p_rgh.primitiveField());
+        const scalarField rho1BeforeThermoRefresh(rho1.primitiveField());
+        const scalarField rho2BeforeThermoRefresh(rho2.primitiveField());
+        const scalarField psi1BeforeThermoRefresh(psi1.primitiveField());
+        const scalarField psi2BeforeThermoRefresh(psi2.primitiveField());
+        mixture.correctThermo();
+        mixture.correct();
+        i4fAlphaFluxRelaxRecordPhaseTDelta(i4fAlphaFluxRelaxSweep);
+        scalar thermoRho1DeltaLocal = 0;
+        scalar thermoRho2DeltaLocal = 0;
+        scalar thermoPsi1DeltaLocal = 0;
+        scalar thermoPsi2DeltaLocal = 0;
+        scalar thermoPrghDeltaLocal = 0;
+        forAll(rho1, celli)
+        {
+            thermoRho1DeltaLocal = max
+            (
+                thermoRho1DeltaLocal,
+                mag(rho1[celli] - rho1BeforeThermoRefresh[celli])
+            );
+            thermoRho2DeltaLocal = max
+            (
+                thermoRho2DeltaLocal,
+                mag(rho2[celli] - rho2BeforeThermoRefresh[celli])
+            );
+            thermoPsi1DeltaLocal = max
+            (
+                thermoPsi1DeltaLocal,
+                mag(psi1[celli] - psi1BeforeThermoRefresh[celli])
+            );
+            thermoPsi2DeltaLocal = max
+            (
+                thermoPsi2DeltaLocal,
+                mag(psi2[celli] - psi2BeforeThermoRefresh[celli])
+            );
+            thermoPrghDeltaLocal = max
+            (
+                thermoPrghDeltaLocal,
+                mag(p_rgh[celli] - pBeforeThermoRefresh[celli])
+            );
+        }
+        reduce(thermoRho1DeltaLocal, maxOp<scalar>());
+        reduce(thermoRho2DeltaLocal, maxOp<scalar>());
+        reduce(thermoPsi1DeltaLocal, maxOp<scalar>());
+        reduce(thermoPsi2DeltaLocal, maxOp<scalar>());
+        reduce(thermoPrghDeltaLocal, maxOp<scalar>());
+        Info<< "I4F_ALPHA_FLUX_RELAX_THERMO_REFRESH"
+            << " sweep=" << i4fAlphaFluxRelaxSweep
+            << " T_held=true"
+            << " max_abs_drho1_kg_m3=" << thermoRho1DeltaLocal
+            << " max_abs_drho2_kg_m3=" << thermoRho2DeltaLocal
+            << " max_abs_dpsi1=" << thermoPsi1DeltaLocal
+            << " max_abs_dpsi2=" << thermoPsi2DeltaLocal
+            << " max_abs_dp_rgh_Pa=" << thermoPrghDeltaLocal
+            << " rhoPhi_recomputed_before_UEqn=true"
+            << " UEqn_assembled_before_thermo_refresh=true"
+            << nl << endl;
+
+        i4fPressureCorrectorIndex = 0;
+        label i4fAlphaFluxRelaxCorrectorCount = 0;
+        while (pimple.correct())
+        {
+            ++i4fAlphaFluxRelaxCorrectorCount;
+            i4fPressureCorrectorIndex = i4fAlphaFluxRelaxCorrectorCount;
+            if (!pimple.finalIter())
+            {
+                FatalErrorInFunction
+                    << "Diagnostic pressure sweep left original final outer state"
+                    << exit(FatalError);
+            }
+            #include "pEqn.H"
+        }
+        if (i4fAlphaFluxRelaxCorrectorCount != 2 || pimple.corrPISO() != 0)
+        {
+            FatalErrorInFunction
+                << "AlphaFluxRelax sweep ran " << i4fAlphaFluxRelaxCorrectorCount
+                << " pressure correctors; expected exactly two"
+                << exit(FatalError);
+        }
+        i4fGammaRaw = dgdt;
+        if (i4fGammaOuterRelaxation != 1.0)
+        {
+            dgdt =
+                (1.0 - i4fGammaOuterRelaxation)*i4fGammaOuterEntry
+              + i4fGammaOuterRelaxation*i4fGammaRaw;
+        }
+
+        i4fAlphaFluxRelaxCaptureHeld(i4fAlphaFluxRelaxSweep, false);
+        if
+        (
+            runTime.timeIndex() != i4fAlphaFluxRelaxTriggerTimeIndex
+         || runTime.value() != i4fAlphaFluxRelaxTriggerTime
+         || runTime.deltaTValue() != i4fAlphaFluxRelaxTriggerDeltaT
+        )
+        {
+            FatalErrorInFunction
+                << "Physical time advanced during the frozen-water alpha flux relaxation map"
+                << exit(FatalError);
+        }
+
+        scalar pMinSweepLocal = GREAT;
+        scalar pMaxSweepLocal = -GREAT;
+        scalar pDeltaLocal = 0;
+        scalar UDeltaLocal = 0;
+        scalar rho1DeltaLocal = 0;
+        scalar rho2DeltaLocal = 0;
+        scalar gammaDeltaLocal = 0;
+        scalar alpha1DeltaLocal = 0;
+        scalar alpha2DeltaLocal = 0;
+        scalar alphaPhi1DeltaLocal = 0;
+        scalar phiDeltaLocal = 0;
+        scalar rhoPhiDeltaLocal = 0;
+        scalar TDeltaLocal = 0;
+        scalar waterInventoryAfterLocal = 0;
+        scalar gasInventoryAfterLocal = 0;
+        scalar dpCurrentNormSqLocal = 0;
+        scalar dpPreviousNormSqLocal = 0;
+        scalar dpDotPreviousLocal = 0;
+        scalarField dpCurrent(mesh.nCells(), Zero);
+        forAll(p, celli)
+        {
+            const scalar dp = p[celli] - pBeforeSweep[celli];
+            dpCurrent[celli] = dp;
+            dpCurrentNormSqLocal += sqr(dp)*mesh.V()[celli];
+            if (i4fAlphaFluxRelaxHavePreviousDp)
+            {
+                dpPreviousNormSqLocal +=
+                    sqr(i4fAlphaFluxRelaxPreviousDp[celli])*mesh.V()[celli];
+                dpDotPreviousLocal +=
+                    i4fAlphaFluxRelaxPreviousDp[celli]*dp*mesh.V()[celli];
+            }
+            pMinSweepLocal = min(pMinSweepLocal, p[celli]);
+            pMaxSweepLocal = max(pMaxSweepLocal, p[celli]);
+            pDeltaLocal = max(pDeltaLocal, mag(dp));
+            UDeltaLocal = max(UDeltaLocal, mag(U[celli] - UBeforeSweep[celli]));
+            rho1DeltaLocal = max(rho1DeltaLocal, mag(rho1[celli] - rho1BeforeSweep[celli]));
+            rho2DeltaLocal = max(rho2DeltaLocal, mag(rho2[celli] - rho2BeforeSweep[celli]));
+            gammaDeltaLocal = max(gammaDeltaLocal, mag(dgdt[celli] - dgdtBeforeSweep[celli]));
+            alpha1DeltaLocal = max(alpha1DeltaLocal, mag(alpha1[celli] - alpha1BeforeSweep[celli]));
+            alpha2DeltaLocal = max(alpha2DeltaLocal, mag(alpha2[celli] - alpha2BeforeSweep[celli]));
+            TDeltaLocal = max(TDeltaLocal, mag(T[celli] - TBeforeSweep[celli]));
+            waterInventoryAfterLocal += alpha1[celli]*rho1[celli]*mesh.V()[celli];
+            gasInventoryAfterLocal += alpha2[celli]*rho2[celli]*mesh.V()[celli];
+        }
+        forAll(alphaPhi10.primitiveField(), facei)
+        {
+            alphaPhi1DeltaLocal = max
+            (
+                alphaPhi1DeltaLocal,
+                mag
+                (
+                    alphaPhi10.primitiveField()[facei]
+                  - alphaPhi1BeforeSweep.primitiveField()[facei]
+                )
+            );
+            phiDeltaLocal = max
+            (
+                phiDeltaLocal,
+                mag(phi.primitiveField()[facei] - phiBeforeSweep.primitiveField()[facei])
+            );
+            rhoPhiDeltaLocal = max
+            (
+                rhoPhiDeltaLocal,
+                mag
+                (
+                    rhoPhi.primitiveField()[facei]
+                  - rhoPhiBeforeSweep.primitiveField()[facei]
+                )
+            );
+        }
+        forAll(alphaPhi10.boundaryField(), patchi)
+        {
+            forAll(alphaPhi10.boundaryField()[patchi], facei)
+            {
+                alphaPhi1DeltaLocal = max
+                (
+                    alphaPhi1DeltaLocal,
+                    mag
+                    (
+                        alphaPhi10.boundaryField()[patchi][facei]
+                      - alphaPhi1BeforeSweep.boundaryField()[patchi][facei]
+                    )
+                );
+                phiDeltaLocal = max
+                (
+                    phiDeltaLocal,
+                    mag
+                    (
+                        phi.boundaryField()[patchi][facei]
+                      - phiBeforeSweep.boundaryField()[patchi][facei]
+                    )
+                );
+                rhoPhiDeltaLocal = max
+                (
+                    rhoPhiDeltaLocal,
+                    mag
+                    (
+                        rhoPhi.boundaryField()[patchi][facei]
+                      - rhoPhiBeforeSweep.boundaryField()[patchi][facei]
+                    )
+                );
+            }
+        }
+        reduce(pMinSweepLocal, minOp<scalar>());
+        reduce(pMaxSweepLocal, maxOp<scalar>());
+        reduce(pDeltaLocal, maxOp<scalar>());
+        reduce(UDeltaLocal, maxOp<scalar>());
+        reduce(rho1DeltaLocal, maxOp<scalar>());
+        reduce(rho2DeltaLocal, maxOp<scalar>());
+        reduce(gammaDeltaLocal, maxOp<scalar>());
+        reduce(alpha1DeltaLocal, maxOp<scalar>());
+        reduce(alpha2DeltaLocal, maxOp<scalar>());
+        reduce(alphaPhi1DeltaLocal, maxOp<scalar>());
+        reduce(phiDeltaLocal, maxOp<scalar>());
+        reduce(rhoPhiDeltaLocal, maxOp<scalar>());
+        reduce(TDeltaLocal, maxOp<scalar>());
+        reduce(waterInventoryAfterLocal, sumOp<scalar>());
+        reduce(gasInventoryAfterLocal, sumOp<scalar>());
+        reduce(dpCurrentNormSqLocal, sumOp<scalar>());
+        reduce(dpPreviousNormSqLocal, sumOp<scalar>());
+        reduce(dpDotPreviousLocal, sumOp<scalar>());
+        scalar dpProjectionPrevious = 0;
+        scalar dpAlignmentCosinePrevious = 0;
+        scalar dpNormRatioPrevious = 0;
+        if
+        (
+            i4fAlphaFluxRelaxHavePreviousDp
+         && dpPreviousNormSqLocal > VSMALL
+         && dpCurrentNormSqLocal > VSMALL
+        )
+        {
+            dpProjectionPrevious = dpDotPreviousLocal/dpPreviousNormSqLocal;
