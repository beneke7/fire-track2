+{
+    FatalErrorInFunction
+        << "Expected exactly two stock alphaSuSp captures (predictor and correction); got "
+        << i4fAlphaFluxRelaxSourceCaptureCalls << exit(FatalError);
+}
+i4fAlphaFluxRelaxCaptureSource = false;
+
+if (nAlphaSubCycles != 1 || LTS)
+{
+    FatalErrorInFunction
+        << "Alpha-flux relaxation requires nAlphaSubCycles=1 and LTS=false"
+        << exit(FatalError);
+}
+
+const scalar i4fAlphaFluxRelaxWeight = i4fAlphaFluxRelaxOmega;
+const scalar i4fAlphaFluxRelaxDt = runTime.deltaTValue();
+if
+(
+    !std::isfinite(i4fAlphaFluxRelaxWeight)
