+    auto metrics =
+        i4fProbeVolumeNorms(i4fProbePlus, i4fProbeMinus, amplitude);
+    const scalar gain = std::get<0>(metrics);
+    const scalar alignment = std::get<1>(metrics);
+    const scalar signedProjection = std::get<2>(metrics);
+    const scalarField& centeredResponse = std::get<3>(metrics);
+    if (amplitudeIndex == 0)
