+auto i4fProbeVolumeNorms =
+[&]
+(const scalarField& plus, const scalarField& minus, const scalar amplitude)
+{
+    scalar localInputSquared = 0;
+    scalar localOutputSquared = 0;
+    scalar localSignedDot = 0;
+    scalarField centered(plus.size(), Zero);
+    forAll(centered, celli)
+    {
+        centered[celli] =
+            0.5*(plus[celli] - minus[celli])/amplitude;
+        const scalar volume = mesh.V()[celli];
+        const scalar v = i4fProbeVNormalized[celli];
+        localInputSquared += volume*sqr(v);
+        localOutputSquared += volume*sqr(centered[celli]);
+        localSignedDot += volume*centered[celli]*v;
+    }
+    reduce(localInputSquared, sumOp<scalar>());
+    reduce(localOutputSquared, sumOp<scalar>());
+    reduce(localSignedDot, sumOp<scalar>());
+    const scalar gain =
+        Foam::sqrt(localOutputSquared/max(localInputSquared, VSMALL));
+    const scalar alignment =
+        localSignedDot
+       /Foam::sqrt(max(localInputSquared*localOutputSquared, VSMALL));
+    const scalar projection =
+        localSignedDot/max(localInputSquared, VSMALL);
+    return std::tuple<scalar, scalar, scalar, scalarField>
+    (
+        gain,
+        alignment,
+        projection,
+        centered
+    );
+};
