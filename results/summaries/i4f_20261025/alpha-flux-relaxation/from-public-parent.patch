+// Separately estimate the one-map centered response around the identical
+// original base state. Each +/- arm receives p_base +/- a*v and is mapped
+// exactly once; these are not the eight-sweep baseline iterations above.
+for (label amplitudeIndex = 0; amplitudeIndex < 2; ++amplitudeIndex)
+{
+    const scalar amplitude = amplitudeIndex == 0 ? 1.0 : 10.0;
+    scalarField plusInput
+    (
+        i4fProbeBasePrghInternal + amplitude*i4fProbeVNormalized
+    );
+    scalarField minusInput
+    (
+        i4fProbeBasePrghInternal - amplitude*i4fProbeVNormalized
+    );
