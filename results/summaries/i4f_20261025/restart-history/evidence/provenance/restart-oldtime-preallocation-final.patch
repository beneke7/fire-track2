+            // The fields have now traversed their first alpha/EOS/UEqn/TEqn/
+            // pEqn uses. Emit exact primitive arrays and indices again to
+            // verify that oldTime still represents the captured checkpoint.
+            i4fLogOldTimeState("after-first-step", "alpha1", alpha1);
+            i4fLogOldTimeState("after-first-step", "alpha2", alpha2);
+            i4fLogOldTimeState("after-first-step", "rho1", rho1);
+            i4fLogOldTimeState("after-first-step", "rho2", rho2);
+            i4fLogOldTimeState("after-first-step", "rho", rho);
+            i4fLogOldTimeState("after-first-step", "U", U);
+            i4fLogOldTimeState("after-first-step", "T", T);
+            i4fLogOldTimeState("after-first-step", "K", K);
+            i4fLogOldTimeState("after-first-step", "p_rgh", p_rgh);
