     // * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
 
     Info<< "\nStarting time loop\n" << endl;
+    Pout.precision(17);
+
+    // One-step restart diagnostic: capture the complete current state as
+    // Euler oldTime before any alpha, EOS, momentum, or energy mutation.
+    // The second oldTime() call advances GeometricField::timeIndex_ after the
+    // first call lazily creates a missing old-time object.
+    bool i4fPreallocationProbePending = true;
+
+    auto i4fLogOldTimeState =
+    [&]
+    (const char* phase, const word& fieldName, const auto& field)
+    {
+        Pout<< "I4F_RESTART_OLDTIME_STATE"
+            << " phase=" << phase
+            << " field=" << fieldName
+            << " current_time_index=" << field.timeIndex()
+            << " old_time_levels=" << field.nOldTimes()
+            << " old_time_index=" << field.oldTime().timeIndex()
+            << " current_primitive=" << field.primitiveField()
+            << " old_primitive=" << field.oldTime().primitiveField()
+            << nl;
+    };
 
     while (runTime.run())
     {
@@ -164,6 +186,39 @@
         }
 
         ++runTime;
+
+        const bool i4fPreallocationProbeStep =
+            i4fPreallocationProbePending;
+        if (i4fPreallocationProbeStep)
+        {
+            // These fields enter Euler ddt/ddtCorr expressions before or
+            // after alpha/EOS updates. Calling oldTime twice is deliberate:
+            // when no *_0 object was read, the first call creates a copy but
+            // does not advance the parent's time index; the second stores
+            // the unchanged checkpoint state and advances that index.
+            alpha1.oldTime(); alpha1.oldTime();
+            alpha2.oldTime(); alpha2.oldTime();
+            rho1.oldTime(); rho1.oldTime();
+            rho2.oldTime(); rho2.oldTime();
+            rho.oldTime(); rho.oldTime();
+            U.oldTime(); U.oldTime();
+            T.oldTime(); T.oldTime();
+            K.oldTime(); K.oldTime();
+            p_rgh.oldTime(); p_rgh.oldTime();
+            phi.oldTime(); phi.oldTime();
+
+            i4fLogOldTimeState("before-first-alpha", "alpha1", alpha1);
+            i4fLogOldTimeState("before-first-alpha", "alpha2", alpha2);
+            i4fLogOldTimeState("before-first-alpha", "rho1", rho1);
+            i4fLogOldTimeState("before-first-alpha", "rho2", rho2);
+            i4fLogOldTimeState("before-first-alpha", "rho", rho);
+            i4fLogOldTimeState("before-first-alpha", "U", U);
+            i4fLogOldTimeState("before-first-alpha", "T", T);
+            i4fLogOldTimeState("before-first-alpha", "K", K);
+            i4fLogOldTimeState("before-first-alpha", "p_rgh", p_rgh);
+            i4fLogOldTimeState("before-first-alpha", "phi", phi);
+            i4fPreallocationProbePending = false;
+        }
 
         Info<< "Time = " << runTime.timeName() << nl << endl;
 
@@ -407,6 +462,23 @@
                 << nl << endl;
         }
 
+        if (i4fPreallocationProbeStep)
