3
(
    withdrawal
    {
        type            patch;
        nFaces          1;
        startFace       59;
    }
    sealedEnd
    {
        type            wall;
        inGroups        1(wall);
        nFaces          1;
        startFace       60;
    }
    emptySides
    {
        type            empty;
        inGroups        1(empty);
        nFaces          240;
        startFace       61;
    }
