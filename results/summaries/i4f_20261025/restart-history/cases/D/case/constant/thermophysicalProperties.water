FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// ************************************************************************* //

thermoType
{
    type heRhoThermo;
    mixture pureMixture;
    transport const;
    thermo hConst;
    equationOfState rhoConst;
    specie specie;
    energy sensibleInternalEnergy;
}
mixture
{
    specie { molWeight 18.01528; }
    equationOfState { rho 998.2; }
    thermodynamics { Cp 4182; Hf 0; }
    transport { mu 0.001002; Pr 1e9; }
}
